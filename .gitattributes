# Canonical VV3 candidate metadata is authenticated as exact UTF-8/no-BOM/LF
# bytes. Keep Git blobs and Windows checkouts byte-identical regardless
# of core.autocrlf or clone configuration.
/data/candidates/vv3_individual_full_mastery_candidate.json text eol=lf
/data/candidates/vv3_individual_full_mastery_candidate_map.json text eol=lf
assets/text-changes/vv4-sm.xml -text
assets/text-changes/vv4-sm-base.xml -text

# Guardians of Isola swap assets are authenticated by exact-byte hashes;
# never let autocrlf rewrite line endings (would break the manifest pins).
data/guardians_of_isola/** -text

# VV4 Heathen-mask head atlases (masked + base) are pinned by exact-byte
# hashes in data/vv4_origins_feature.json; keep blobs byte-identical.
assets/vv4_masks/** -text

# The VV5 Origins payload is pinned by a RAW byte hash (ACTIVE_SHA256 in
# scripts/build_vv5_task9_native_actions.py), which sits at the base of VV5's
# seven-layer identity chain. Without an EOL rule the hash follows
# core.autocrlf, so a Windows checkout and an LF checkout settle to different
# chains and the generator's identity check fails on whichever one did not
# produce the pin.
/data/vv5_origins_feature.json text eol=lf

# Every JSON below is pinned by a RAW whole-file sha256 that appears in
# scripts/ or src/, exactly like data/vv5_origins_feature.json above.
# Without an EOL rule those hashes follow core.autocrlf, so a Windows
# checkout and an LF checkout produce different bytes and the generator's
# identity check fails on whichever one did not create the pin. The set is
# mechanically derived -- a file belongs here if and only if its raw
# sha256 is pinned in code -- and is asserted by
# tests/test_raw_pinned_files_are_eol_pinned.py.
