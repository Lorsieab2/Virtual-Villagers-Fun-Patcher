{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "vvfp.native_atomic_save_publication_evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "schema_version", "feature", "enabled", "native_emission", "runtime_certified", "player_certified", "publication", "games", "nonqualifying_proofs"],
  "properties": {
    "schema": {"const": "vvfp.native_atomic_save_publication_evidence"},
    "schema_version": {"const": 1},
    "feature": {"const": "native_atomic_save_publication"},
    "enabled": {"const": false},
    "native_emission": {"const": false},
    "runtime_certified": {"const": false},
    "player_certified": {"const": false},
    "publication": {"const": false},
    "games": {"type": "object", "additionalProperties": false, "required": ["vv3", "vv4", "vv5"], "properties": {"vv3": {"$ref": "#/$defs/game"}, "vv4": {"$ref": "#/$defs/game"}, "vv5": {"$ref": "#/$defs/game"}}},
    "nonqualifying_proofs": {"const": ["stock_backup_rotation", "serializer_arithmetic_only"]}
  },
  "$defs": {
    "nullable": {"type": ["object", "integer", "string", "boolean", "null"]},
    "game": {
      "type": "object", "additionalProperties": false,
      "required": ["stock", "native", "file_shape", "stock_defects", "requirements", "evidence", "runtime_receipts", "player_receipts"],
      "properties": {
        "stock": {"type": "object"}, "native": {"type": "object"}, "file_shape": {"type": "object"}, "stock_defects": {"type": "object"},
        "requirements": {"type": "array", "uniqueItems": true, "minItems": 10, "items": {"type": "string"}},
        "evidence": {"type": "array"}, "runtime_receipts": {"type": "array"}, "player_receipts": {"type": "array"}
      }
    }
  }
}
