{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "vvfp.vv3_expanded_256_stored_index_evidence",
  "title": "Future authenticated VV3 stored-index and padding evidence candidate",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "schema_version", "status", "evidence_class", "synthetic", "ambiguous", "incomplete", "provenance", "paths", "serializer_binding", "padding_records", "receipt_binding"],
  "properties": {
    "schema": {"const": "vvfp.vv3_expanded_256_stored_index_evidence"},
    "schema_version": {"const": 1},
    "status": {"const": "observed"},
    "evidence_class": {"const": "authenticated_vv3_native_observation"},
    "synthetic": {"const": false},
    "ambiguous": {"const": false},
    "incomplete": {"const": false},
    "provenance": {"$ref": "#/$defs/provenance"},
    "paths": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "prefixItems": [
        {"$ref": "#/$defs/path_selection"},
        {"$ref": "#/$defs/path_sorted_roster"},
        {"$ref": "#/$defs/path_detail_navigation"},
        {"$ref": "#/$defs/path_planner_action_queue"},
        {"$ref": "#/$defs/path_pairing_pregnancy"},
        {"$ref": "#/$defs/path_birth_death"},
        {"$ref": "#/$defs/path_skeleton_memorial"},
        {"$ref": "#/$defs/path_event_puzzle"},
        {"$ref": "#/$defs/path_statistics"},
        {"$ref": "#/$defs/path_callbacks"}
      ],
      "items": false
    },
    "serializer_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "status", "record_255_saved", "padding_saved", "observations"],
      "properties": {
        "id": {"const": "serializer"},
        "status": {"const": "observed"},
        "record_255_saved": {"const": true},
        "padding_saved": {"const": false},
        "observations": {"$ref": "#/$defs/observations"}
      }
    },
    "padding_records": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "prefixItems": [
        {"$ref": "#/$defs/padding_256"},
        {"$ref": "#/$defs/padding_257"},
        {"$ref": "#/$defs/padding_258"},
        {"$ref": "#/$defs/padding_259"}
      ],
      "items": false
    },
    "receipt_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "schema_sha256", "receipt_id", "stage_ids", "player_confirmed"],
      "properties": {
        "schema": {"const": "vvfp.vv3_expanded_256_runtime_capture_receipt"},
        "schema_sha256": {"const": "52F8B12D1FFBB87A5D25381DD6D8172B118467015F17C805C10F5604E6FAAB52"},
        "receipt_id": {"type": "string", "minLength": 1},
        "stage_ids": {"const": ["padding_unreachable_records", "stored_index_sentinel_paths"]},
        "player_confirmed": {"const": true}
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9A-F]{64}$"},
    "hex_integer": {"oneOf": [{"type": "integer", "minimum": 0}, {"type": "string", "pattern": "^(?:0x)?[0-9A-Fa-f]+$"}]},
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["game_id", "source_sha256", "prototype_sha256", "evidence_sha256", "exporter_manifest_sha256", "exporter_manifest_file_sha256", "exporter_producer", "exporter_run_id", "authenticated_by"],
      "properties": {
        "game_id": {"const": "vv3"},
        "source_sha256": {"const": "8BC5DB382D02BC5C21AD5F607580D60FF44A6519CC7EB133F03113BAACAE6503"},
        "prototype_sha256": {"const": "6EE3361A7AC35F441763647C1E2FC9EC49569DE5EF372BDB41D243D03002D601"},
        "evidence_sha256": {"$ref": "#/$defs/sha256"},
        "exporter_manifest_sha256": {"$ref": "#/$defs/sha256"},
        "exporter_manifest_file_sha256": {"$ref": "#/$defs/sha256"},
        "exporter_producer": {"const": "vv3-ida-exporter"},
        "exporter_run_id": {"type": "string", "minLength": 1},
        "authenticated_by": {"const": "validate_evidence_file"}
      }
    },
    "derivation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["game_id", "source_kind", "cross_game_source", "inferred"],
      "properties": {
        "game_id": {"const": "vv3"},
        "source_kind": {"const": "authenticated_native_observation"},
        "cross_game_source": {"type": "null"},
        "inferred": {"const": false}
      }
    },
    "sentinel": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "width_bits", "signed", "value", "raw_bytes", "source", "observation_refs"],
          "properties": {
            "kind": {"const": "none"},
            "width_bits": {"enum": [8, 16, 32, 64]},
            "signed": {"type": "boolean"},
            "value": {"type": "null"},
            "raw_bytes": {"type": "null"},
            "source": {"const": "authenticated_vv3_observation"},
            "observation_refs": {"$ref": "#/$defs/nonempty_refs"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "width_bits", "signed", "value", "raw_bytes", "source", "observation_refs"],
          "properties": {
            "kind": {"const": "value"},
            "width_bits": {"enum": [8, 16, 32, 64]},
            "signed": {"type": "boolean"},
            "value": {"type": "integer"},
            "raw_bytes": {"type": "string", "pattern": "^(?:[0-9A-F]{2})+$"},
            "source": {"const": "authenticated_vv3_observation"},
            "observation_refs": {"$ref": "#/$defs/nonempty_refs"}
          }
        }
      ]
    },
    "record_255": {
      "type": "object",
      "additionalProperties": false,
      "required": ["accepted", "saveable", "observation_refs"],
      "properties": {
        "accepted": {"const": true},
        "saveable": {"const": true},
        "observation_refs": {"$ref": "#/$defs/nonempty_refs"}
      }
    },
    "xref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ea", "kind"],
      "properties": {
        "ea": {"$ref": "#/$defs/hex_integer"},
        "kind": {"type": "string", "minLength": 1}
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ea", "file_offset", "raw_bytes", "artifact_id", "xref_set_complete", "xrefs"],
      "properties": {
        "ea": {"$ref": "#/$defs/hex_integer"},
        "file_offset": {"$ref": "#/$defs/hex_integer"},
        "raw_bytes": {"type": "string", "pattern": "^(?:[0-9A-F]{2})+$"},
        "artifact_id": {"type": "string", "minLength": 1},
        "xref_set_complete": {"const": true},
        "xrefs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/xref"}}
      }
    },
    "observations": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/observation"}},
    "nonempty_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "path": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ordinal", "id", "status", "derivation", "width_bits", "sentinel", "record_255", "observations"],
      "properties": {
        "ordinal": {"type": "integer", "minimum": 1, "maximum": 10},
        "id": {"type": "string"},
        "status": {"const": "observed"},
        "derivation": {"$ref": "#/$defs/derivation"},
        "width_bits": {"enum": [8, 16, 32, 64]},
        "sentinel": {"$ref": "#/$defs/sentinel"},
        "record_255": {"$ref": "#/$defs/record_255"},
        "observations": {"$ref": "#/$defs/observations"}
      }
    },
    "path_selection": {"allOf": [{"$ref": "#/$defs/path"}, {"properties": {"ordinal": {"const": 1}, "id": {"const": "selection"}}}]},
    "path_sorted_roster": {"allOf": [{"$ref": "#/$defs/path"}, {"properties": {"ordinal": {"const": 2}, "id": {"const": "sorted_roster"}}}]},
    "path_detail_navigation": {"allOf": [{"$ref": "#/$defs/path"}, {"properties": {"ordinal": {"const": 3}, "id": {"const": "detail_navigation"}}}]},
    "path_planner_action_queue": {"allOf": [{"$ref": "#/$defs/path"}, {"properties": {"ordinal": {"const": 4}, "id": {"const": "planner_action_queue"}}}]},
    "path_pairing_pregnancy": {"allOf": [{"$ref": "#/$defs/path"}, {"properties": {"ordinal": {"const": 5}, "id": {"const": "pairing_pregnancy"}}}]},
    "path_birth_death": {"allOf": [{"$ref": "#/$defs/path"}, {"properties": {"ordinal": {"const": 6}, "id": {"const": "birth_death"}}}]},
    "path_skeleton_memorial": {"allOf": [{"$ref": "#/$defs/path"}, {"properties": {"ordinal": {"const": 7}, "id": {"const": "skeleton_memorial"}}}]},
    "path_event_puzzle": {"allOf": [{"$ref": "#/$defs/path"}, {"properties": {"ordinal": {"const": 8}, "id": {"const": "event_puzzle"}}}]},
    "path_statistics": {"allOf": [{"$ref": "#/$defs/path"}, {"properties": {"ordinal": {"const": 9}, "id": {"const": "statistics"}}}]},
    "path_callbacks": {"allOf": [{"$ref": "#/$defs/path"}, {"properties": {"ordinal": {"const": 10}, "id": {"const": "callbacks"}}}]},
    "padding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["index", "reachable", "saveable", "required_path_refs", "observation_refs"],
      "properties": {
        "index": {"type": "integer"},
        "reachable": {"const": false},
        "saveable": {"const": false},
        "required_path_refs": {"const": ["construction", "selection", "serialization", "population_counting", "statistics"]},
        "observation_refs": {"$ref": "#/$defs/nonempty_refs"}
      }
    },
    "padding_256": {"allOf": [{"$ref": "#/$defs/padding"}, {"properties": {"index": {"const": 256}}}]},
    "padding_257": {"allOf": [{"$ref": "#/$defs/padding"}, {"properties": {"index": {"const": 257}}}]},
    "padding_258": {"allOf": [{"$ref": "#/$defs/padding"}, {"properties": {"index": {"const": 258}}}]},
    "padding_259": {"allOf": [{"$ref": "#/$defs/padding"}, {"properties": {"index": {"const": 259}}}]}
  }
}
