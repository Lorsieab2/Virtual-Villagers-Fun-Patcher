  "intro": {
   "name": "The beginning",
   "text": "To celebrate the village's hardworking builders, farmers, and gatherers, the elders announce a friendly strength competition. Coconuts are stacked, water-filled clay jugs are carefully inspected, sturdy fallen logs are marked, and a large stone is placed at the edge of the clearing. (Strongman) volunteers. Several spectators immediately begin arguing about which feat should count as the greatest demonstration of strength.",
   "src": "L9633-9638",
   "children": [
    {
     "next": "question"
    }
   ],
   "text_only": [
    {
     "src": "L9633",
     "what": "celebrate",
     "reason": "narrative: 'celebrate' is part of the story, not a change the event makes"
    }
   ]
  },
  "question": {
   "type": "question",
   "name": "The choice",
   "text": "WHAT CHALLENGE SHOULD (STRONGMAN) ATTEMPT?",
   "src": "L9640",
   "choices": [
    {
     "label": "THE COCONUT CARRY",
     "next": "set_a",
     "src": "L9642"
    },
    {
     "label": "THE WATER-JUG LIFT",
     "next": "set_b",
     "src": "L9655"
    },
    {
     "label": "THE BOULDER OR LOG CHALLENGE",
     "next": "set_c",
     "src": "L9667"
    },
    {
     "label": "THE WILLING-VILLAGER CARRY",
     "next": "set_d",
     "src": "L9678"
    },
    {
     "label": "THE GRAND STRENGTH CIRCUIT",
     "next": "set_e",
     "src": "L9691"
    }
   ]
  },
  "a1": {
   "text": "The Walking Coconut Mountain: (Strongman) carries an astonishing number of coconuts across the finish line.",
   "src": "L9643-9645",
   "children": [
    {
     "next": "coda"
    }
   ],
   "text_only": [
    {
     "src": "L9644",
     "what": "Physical skill",
     "reason": "rule 8: no game has a Physical skill"
    }
   ]
  },
  "a2": {
   "text": "The Clever Basket: (Strongman) uses a huge woven carrier and wins. The judges argue whether cleverness counts. The elders decide either to honor the feat or to introduce a separate ingenuity prize.",
   "src": "L9646-9648",
   "children": [
    {
     "next": "coda"
    }
   ]
  },
  "a3": {
   "text": "The Great Coconut Avalanche: The stack tumbles harmlessly into the sand. Children race to collect the runaway coconuts while (Strongman) bows to the laughing crowd.",
   "src": "L9649-9651",
   "children": [
    {
     "next": "coda"
    }
   ]
  },
  "a4": {
   "text": "The Patient Champion: A rival starts with more coconuts but drops them. (Strongman)'s slower, steadier effort wins the contest.",
   "src": "L9652-9653",
   "children": [
    {
     "next": "coda"
    }
   ]
  },
