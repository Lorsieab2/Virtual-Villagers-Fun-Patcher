      "companion_files": [
        {
          "destination": "VVFP Parentage Export.dll",
          "sha256": "C918995C69FEA95120147F9C8A4195AE3066C9C30D9C18201F6AF2C999BFFFA4",
          "source": "assets/parentage/VVFP Parentage Export.dll"
        }
      ],
      "description": "On each new pregnancy, appends the mother's and father's names, both parents' ages at conception, both head and body values, both parents' likes and dislikes, and the number of babies to 'Virtual Villagers 4 Births and Conceptions Log N.txt' beside the game executable. Parentage is not stored in any villager record, so both parents are captured at conception; they cannot be recovered from the child afterwards. Village seeding is excluded, so a new village does not write a record for every starting villager. Rolls to a new numbered file every 256 records. The game keeps only the father's name on the mother's record. His HEAD and BODY are copied onto her at conception, so the log reads them from her record and they stay correct even after he dies or another villager takes his name. His AGE, which has no copy on her, is read from his own record at conception -- the moment the engine hands both parents to the hook -- so a normal birth records his real age.",
      "game_id": "vv4",
      "id": "vv4_write_parentage_log",
      "name": "Write Births and Conceptions Log to Text File",
      "needs_on": [
