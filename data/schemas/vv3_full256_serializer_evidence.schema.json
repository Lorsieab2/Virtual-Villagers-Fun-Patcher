{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "vvfp.vv3_full256_serializer_evidence.v1",
  "type": "object",
  "required": ["schema_version", "status", "enabled", "catalog_visible", "native_output", "runtime_go", "player_go", "publication_ready", "bindings", "replacement", "atomic_writer", "whole_load_rollback", "runtime_evidence", "player_evidence"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "vvfp.vv3_full256_serializer_evidence.v1"},
    "status": {"const": "static_serializer_reader_go_writer_rollback_stop"},
    "enabled": {"const": false},
    "catalog_visible": {"const": false},
    "native_output": {"const": false},
    "runtime_go": {"const": false},
    "player_go": {"const": false},
    "publication_ready": {"const": false},
    "bindings": {
      "type": "object",
      "required": ["stock_sha256", "expanded_manifest", "parents"],
      "additionalProperties": false,
      "properties": {
        "stock_sha256": {"type": "string", "pattern": "^[0-9A-F]{64}$"},
        "expanded_manifest": {
          "type": "object",
          "required": ["path", "row_count", "rows_sha256"],
          "additionalProperties": false,
          "properties": {
            "path": {"const": "data/expanded_256.json"},
            "row_count": {"const": 1263},
            "rows_sha256": {"type": "string", "pattern": "^[0-9A-F]{64}$"}
          }
        },
        "parents": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "object",
            "required": ["mode", "sha256", "size"],
            "additionalProperties": false,
            "properties": {
              "mode": {"enum": ["experimental_expanded_256", "experimental_expanded_256_progression"]},
              "sha256": {"type": "string", "pattern": "^[0-9A-F]{64}$"},
              "size": {"const": 835584}
            }
          }
        }
      }
    },
    "replacement": {
      "type": "object",
      "required": ["section", "section_raw", "section_rva", "section_va", "section_sha256", "serializer_raw", "serializer_sha256", "deserializer_raw", "deserializer_sha256", "failure_gate_raw", "failure_gate_sha256", "serializer_hook", "deserializer_hook", "results"],
      "additionalProperties": false,
      "properties": {
        "section": {"const": ".vv3sv"},
        "section_raw": {"const": "0xCC000"},
        "section_rva": {"const": "0x3B9000"},
        "section_va": {"const": "0x7B9000"},
        "section_sha256": {"type": "string", "pattern": "^[0-9A-F]{64}$"},
        "serializer_raw": {"const": "0xCC000"},
        "serializer_sha256": {"type": "string", "pattern": "^[0-9A-F]{64}$"},
        "deserializer_raw": {"const": "0xCC200"},
        "deserializer_sha256": {"type": "string", "pattern": "^[0-9A-F]{64}$"},
        "failure_gate_raw": {"const": "0xCC3C0"},
        "failure_gate_sha256": {"type": "string", "pattern": "^[0-9A-F]{64}$"},
        "serializer_hook": {"$ref": "#/$defs/hook"},
        "deserializer_hook": {"$ref": "#/$defs/hook"},
        "results": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {"$ref": "#/$defs/result"}
        }
      }
    },
    "atomic_writer": {"$ref": "#/$defs/stopArtifact"},
    "whole_load_rollback": {"$ref": "#/$defs/stopArtifact"},
    "runtime_evidence": {"$ref": "#/$defs/absentEvidence"},
    "player_evidence": {"$ref": "#/$defs/absentEvidence"}
  },
  "$defs": {
    "hook": {
      "type": "object",
      "required": ["raw", "before", "after", "target"],
      "additionalProperties": false,
      "properties": {
        "raw": {"type": "string"},
        "before": {"type": "string", "pattern": "^[0-9A-F]+$"},
        "after": {"type": "string", "pattern": "^[0-9A-F]+$"},
        "target": {"type": "string"}
      }
    },
    "result": {
      "type": "object",
      "required": ["mode", "sha256", "checksum"],
      "additionalProperties": false,
      "properties": {
        "mode": {"enum": ["experimental_expanded_256", "experimental_expanded_256_progression"]},
        "sha256": {"type": "string", "pattern": "^[0-9A-F]{64}$"},
        "checksum": {"type": "string", "pattern": "^[0-9A-F]{8}$"}
      }
    },
    "stopArtifact": {
      "type": "object",
      "required": ["status", "hook_raw", "hook_before", "hook_after", "final_sha256"],
      "properties": {
        "status": {"const": "STOP"},
        "hook_raw": {"type": "null"},
        "hook_before": {"type": "null"},
        "hook_after": {"type": "null"},
        "wrapper_bytes": {"type": "null"},
        "resolver_bytes": {"type": "null"},
        "snapshot_bytes": {"type": "null"},
        "rollback_bytes": {"type": "null"},
        "final_sha256": {"type": "null"}
      },
      "additionalProperties": false
    },
    "absentEvidence": {
      "type": "object",
      "required": ["status", "receipts"],
      "additionalProperties": false,
      "properties": {
        "status": {"const": "absent"},
        "receipts": {"type": "array", "maxItems": 0}
      }
    }
  }
}
