{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "vvfp.equal_division_evidence",
  "title": "Equal Division native evidence gate",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "schema_version", "feature", "enabled", "publication", "composition_features", "forbidden_routes", "games"],
  "properties": {
    "schema": {"const": "vvfp.equal_division_evidence"},
    "schema_version": {"const": 1},
    "feature": {"const": "equal_division"},
    "enabled": {"const": false},
    "publication": {"$ref": "#/$defs/publication"},
    "composition_features": {"const": ["full_mastery", "grant_running", "full_heal"]},
    "forbidden_routes": {"type": "array", "minItems": 2, "items": {"$ref": "#/$defs/forbidden"}},
    "games": {
      "type": "object", "additionalProperties": false,
      "required": ["vv3", "vv4", "vv5"],
      "properties": {"vv3": {"$ref": "#/$defs/game"}, "vv4": {"$ref": "#/$defs/game"}, "vv5": {"$ref": "#/$defs/game"}}
    }
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9A-Fa-f]{64}$"},
    "publication": {
      "type": "object", "additionalProperties": false, "required": ["status", "reason"],
      "properties": {"status": {"const": "disabled"}, "reason": {"type": "string", "minLength": 1}}
    },
    "game": {
      "type": "object", "additionalProperties": false,
      "required": ["stock", "policy", "requirements", "receipts"],
      "properties": {
        "stock": {"$ref": "#/$defs/stock"},
        "policy": {
          "type": "object", "additionalProperties": false,
          "required": ["assignment_target", "reviewed_preference_order", "parenting_policy", "devotion_policy", "nursery_divisor_related"],
          "properties": {
            "assignment_target": {"const": "preference_selector"},
            "reviewed_preference_order": {"type": "array", "minItems": 5, "items": {"$ref": "#/$defs/job"}},
            "parenting_policy": {"const": "evidence_required"},
            "devotion_policy": {"enum": ["evidence_required", "not_present_do_not_synthesize"]},
            "nursery_divisor_related": {"const": false}
          }
        },
        "requirements": {"type": "array", "minItems": 11, "items": {"$ref": "#/$defs/requirement"}},
        "receipts": {"type": "array", "items": {"$ref": "#/$defs/receipt"}}
      }
    },
    "job": {
      "type": "object", "additionalProperties": false, "required": ["id", "name"],
      "properties": {"id": {"type": "integer", "minimum": 0}, "name": {"type": "string", "minLength": 1}}
    },
    "stock": {
      "type": "object", "additionalProperties": false,
      "required": ["exe_name", "size", "imagebase", "sha256", "full_folder"],
      "properties": {
        "exe_name": {"type": "string", "minLength": 1}, "size": {"type": "integer", "minimum": 1},
        "imagebase": {"const": 4194304}, "sha256": {"$ref": "#/$defs/hash"},
        "full_folder": {
          "type": "object", "additionalProperties": false,
          "required": ["status", "sha256", "file_count", "manifest_sha256"],
          "properties": {
            "status": {"enum": ["missing", "verified", "rejected"]},
            "sha256": {"anyOf": [{"$ref": "#/$defs/hash"}, {"type": "null"}]},
            "file_count": {"anyOf": [{"type": "integer", "minimum": 1}, {"type": "null"}]},
            "manifest_sha256": {"anyOf": [{"$ref": "#/$defs/hash"}, {"type": "null"}]}
          }
        }
      }
    },
    "requirement": {
      "type": "object", "additionalProperties": false, "required": ["id", "status", "evidence_ids"],
      "properties": {
        "id": {"enum": ["stock_fingerprint", "villager_record_geometry", "sex_field_encoding", "eligibility_predicate", "job_table_policy", "deterministic_physical_cycle", "native_job_setter_effects", "repeat_transaction_rollback", "save_reload_catchup_idempotence", "hook_cave_composition", "runtime_player_evidence"]},
        "status": {"enum": ["missing", "verified", "rejected"]},
        "evidence_ids": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "receipt": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "requirement", "status", "synthetic", "stale", "source_sha256", "proof", "regions"],
      "properties": {
        "id": {"type": "string", "minLength": 1}, "requirement": {"type": "string", "minLength": 1},
        "status": {"enum": ["verified", "missing", "rejected"]}, "synthetic": {"type": "boolean"}, "stale": {"type": "boolean"},
        "source_sha256": {"$ref": "#/$defs/hash"}, "proof": {"type": "object"},
        "regions": {"type": "array", "items": {"$ref": "#/$defs/region"}}
      }
    },
    "region": {
      "type": "object", "additionalProperties": false, "required": ["kind", "start", "length"],
      "properties": {"kind": {"type": "string", "minLength": 1}, "start": {"type": ["integer", "string"]}, "length": {"type": "integer", "minimum": 1}}
    },
    "forbidden": {
      "type": "object", "additionalProperties": false, "required": ["id", "game_id", "kind", "value"],
      "properties": {"id": {"type": "string", "minLength": 1}, "game_id": {"type": "string", "minLength": 1}, "kind": {"type": "string", "minLength": 1}, "value": {"type": ["integer", "string", "null"]}}
    }
  }
}
