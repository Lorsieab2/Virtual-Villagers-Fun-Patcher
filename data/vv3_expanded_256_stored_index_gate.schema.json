{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "vvfp.vv3_expanded_256_stored_index_gate",
  "title": "Disabled VV3 Expanded-256 stored-index and padding evidence gate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_version",
    "contract_id",
    "contract_status",
    "integrity",
    "publication",
    "source_provenance",
    "evidence_policy",
    "reviewed_expectations",
    "paths",
    "serializer_binding",
    "padding_contract",
    "runtime_evidence"
  ],
  "properties": {
    "schema": {"const": "vvfp.vv3_expanded_256_stored_index_gate"},
    "schema_version": {"const": 1},
    "contract_id": {"const": "x3-vv3-expanded-256-stored-index-padding-gate"},
    "contract_status": {"const": "static_contract_only"},
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["canonicalization", "canonical_sha256"],
      "properties": {
        "canonicalization": {"type": "string", "minLength": 1},
        "canonical_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "publication": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "runtime_go", "player_go", "eligible", "reason"],
      "properties": {
        "enabled": {"const": false},
        "runtime_go": {"const": false},
        "player_go": {"const": false},
        "eligible": {"const": false},
        "reason": {"type": "string", "minLength": 1}
      }
    },
    "source_provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authenticated_evidence_commit", "runtime_receipt_commit", "source_sha256", "prototype_sha256", "receipt_schema", "required_receipt_stage_ids", "source_files"],
      "properties": {
        "authenticated_evidence_commit": {"const": "8444df9c314f8ee9a6a29930a9d1be1e70e6adb7"},
        "runtime_receipt_commit": {"const": "0940bb5328217aee7a08963ce22c7dddc3ca4503"},
        "source_sha256": {"const": "8BC5DB382D02BC5C21AD5F607580D60FF44A6519CC7EB133F03113BAACAE6503"},
        "prototype_sha256": {"const": "6EE3361A7AC35F441763647C1E2FC9EC49569DE5EF372BDB41D243D03002D601"},
        "receipt_schema": {"const": "vvfp.vv3_expanded_256_runtime_capture_receipt"},
        "required_receipt_stage_ids": {"const": ["padding_unreachable_records", "stored_index_sentinel_paths"]},
        "source_files": {
          "type": "array",
          "minItems": 7,
          "maxItems": 7,
          "items": {"$ref": "#/$defs/source_file"}
        }
      }
    },
    "evidence_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["game_id", "required_evidence_class", "forbidden_assumptions", "require_complete_xref_sets", "require_authenticated_exporter_provenance"],
      "properties": {
        "game_id": {"const": "vv3"},
        "required_evidence_class": {"const": "authenticated_vv3_native_observation"},
        "forbidden_assumptions": {"const": ["byte_0xFF_sentinel_inference", "vv5_dword_minus_one_borrowing", "cross_game_width_or_sentinel_borrowing"]},
        "require_complete_xref_sets": {"const": true},
        "require_authenticated_exporter_provenance": {"const": true}
      }
    },
    "reviewed_expectations": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reason", "widths", "sentinels", "exact_eas", "complete_xrefs"],
      "properties": {
        "status": {"const": "absent"},
        "reason": {"type": "string", "minLength": 1},
        "widths": {"type": "null"},
        "sentinels": {"type": "null"},
        "exact_eas": {"type": "null"},
        "complete_xrefs": {"type": "null"}
      }
    },
    "paths": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "prefixItems": [
        {"$ref": "#/$defs/path_selection"},
        {"$ref": "#/$defs/path_sorted_roster"},
        {"$ref": "#/$defs/path_detail_navigation"},
        {"$ref": "#/$defs/path_planner_action_queue"},
        {"$ref": "#/$defs/path_pairing_pregnancy"},
        {"$ref": "#/$defs/path_birth_death"},
        {"$ref": "#/$defs/path_skeleton_memorial"},
        {"$ref": "#/$defs/path_event_puzzle"},
        {"$ref": "#/$defs/path_statistics"},
        {"$ref": "#/$defs/path_callbacks"}
      ],
      "items": false
    },
    "serializer_binding": {"$ref": "#/$defs/serializer_pending"},
    "padding_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["logical_max_index", "indices", "status", "reachable", "saveable", "required_paths", "observation_refs"],
      "properties": {
        "logical_max_index": {"const": 255},
        "indices": {"const": [256, 257, 258, 259]},
        "status": {"const": "evidence_absent"},
        "reachable": {"type": "null"},
        "saveable": {"type": "null"},
        "required_paths": {"const": ["construction", "selection", "serialization", "population_counting", "statistics"]},
        "observation_refs": {"const": []}
      }
    },
    "runtime_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "candidate", "authenticated_source", "structural_valid", "gate_ready"],
      "properties": {
        "status": {"const": "absent"},
        "candidate": {"type": "null"},
        "authenticated_source": {"const": false},
        "structural_valid": {"const": false},
        "gate_ready": {"const": false}
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9A-F]{64}$"},
    "source_file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "record_255_pending": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "accepted", "saveable", "observation_refs"],
      "properties": {
        "status": {"const": "unproven"},
        "accepted": {"type": "null"},
        "saveable": {"type": "null"},
        "observation_refs": {"const": []}
      }
    },
    "path_pending": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ordinal", "id", "status", "expected_width_bits", "expected_sentinel", "expected_observation_eas", "expected_complete_xrefs", "record_255", "evidence_refs"],
      "properties": {
        "ordinal": {"type": "integer", "minimum": 1, "maximum": 10},
        "id": {"type": "string"},
        "status": {"const": "evidence_absent"},
        "expected_width_bits": {"type": "null"},
        "expected_sentinel": {"type": "null"},
        "expected_observation_eas": {"const": []},
        "expected_complete_xrefs": {"const": []},
        "record_255": {"$ref": "#/$defs/record_255_pending"},
        "evidence_refs": {"const": []}
      }
    },
    "path_selection": {"allOf": [{"$ref": "#/$defs/path_pending"}, {"properties": {"ordinal": {"const": 1}, "id": {"const": "selection"}}}]},
    "path_sorted_roster": {"allOf": [{"$ref": "#/$defs/path_pending"}, {"properties": {"ordinal": {"const": 2}, "id": {"const": "sorted_roster"}}}]},
    "path_detail_navigation": {"allOf": [{"$ref": "#/$defs/path_pending"}, {"properties": {"ordinal": {"const": 3}, "id": {"const": "detail_navigation"}}}]},
    "path_planner_action_queue": {"allOf": [{"$ref": "#/$defs/path_pending"}, {"properties": {"ordinal": {"const": 4}, "id": {"const": "planner_action_queue"}}}]},
    "path_pairing_pregnancy": {"allOf": [{"$ref": "#/$defs/path_pending"}, {"properties": {"ordinal": {"const": 5}, "id": {"const": "pairing_pregnancy"}}}]},
    "path_birth_death": {"allOf": [{"$ref": "#/$defs/path_pending"}, {"properties": {"ordinal": {"const": 6}, "id": {"const": "birth_death"}}}]},
    "path_skeleton_memorial": {"allOf": [{"$ref": "#/$defs/path_pending"}, {"properties": {"ordinal": {"const": 7}, "id": {"const": "skeleton_memorial"}}}]},
    "path_event_puzzle": {"allOf": [{"$ref": "#/$defs/path_pending"}, {"properties": {"ordinal": {"const": 8}, "id": {"const": "event_puzzle"}}}]},
    "path_statistics": {"allOf": [{"$ref": "#/$defs/path_pending"}, {"properties": {"ordinal": {"const": 9}, "id": {"const": "statistics"}}}]},
    "path_callbacks": {"allOf": [{"$ref": "#/$defs/path_pending"}, {"properties": {"ordinal": {"const": 10}, "id": {"const": "callbacks"}}}]},
    "serializer_pending": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "status", "record_255_saved", "padding_saved", "expected_observation_eas", "expected_complete_xrefs", "evidence_refs"],
      "properties": {
        "id": {"const": "serializer"},
        "status": {"const": "evidence_absent"},
        "record_255_saved": {"type": "null"},
        "padding_saved": {"type": "null"},
        "expected_observation_eas": {"const": []},
        "expected_complete_xrefs": {"const": []},
        "evidence_refs": {"const": []}
      }
    }
  }
}
