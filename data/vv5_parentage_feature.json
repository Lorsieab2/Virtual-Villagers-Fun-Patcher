      "companion_files": [
        {
          "destination": "VVFP Parentage Export.dll",
          "sha256": "E46CE6A2AF21FC8899AFFA44E1E9AC3E3FED89474B1DD3E12230E4F204380AA5",
          "source": "assets/parentage/VVFP Parentage Export.dll"
