{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "vv5_full_heal_native_abi_evidence.schema.json",
  "title": "Disabled VV5 Full Heal native ABI evidence gate",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "game_id", "enabled", "catalog_hidden", "catalog_enabled", "publication_ready", "native_output", "status", "stock", "folder_evidence", "record_contract", "native_abis", "transaction_evidence", "messages", "ui_lifecycle", "composition"],
  "properties": {
    "id": {"const": "vv5_full_heal_native_abi_evidence_gate"}, "game_id": {"const": "vv5"},
    "enabled": {"const": false}, "catalog_hidden": {"const": true}, "catalog_enabled": {"const": false},
    "publication_ready": {"const": false}, "native_output": {"const": false},
    "status": {"const": "STOP: native Full Heal ABIs and player lifecycle evidence are unproved"},
    "stock": {"$ref": "#/$defs/stock"}, "folder_evidence": {"$ref": "#/$defs/folder"},
    "record_contract": {"$ref": "#/$defs/record"}, "native_abis": {"$ref": "#/$defs/abis"},
    "transaction_evidence": {"$ref": "#/$defs/transaction"}, "messages": {"$ref": "#/$defs/messages"},
    "ui_lifecycle": {"$ref": "#/$defs/ui"}, "composition": {"$ref": "#/$defs/composition"}
  },
  "$defs": {
    "shaOrNull": {"anyOf": [{"type": "string", "pattern": "^[0-9A-F]{64}$"}, {"type": "null"}]},
    "textOrNull": {"anyOf": [{"type": "string", "minLength": 1}, {"type": "null"}]},
    "stock": {"type": "object", "additionalProperties": false, "required": ["filename", "size", "sha256"], "properties": {"filename": {"const": "Virtual Villagers - New Believers.exe"}, "size": {"const": 991232}, "sha256": {"const": "92946781980220E9D1A2E6C573925519934608F5215F4A0F8CE3B90088C5C65D"}}},
    "folder": {"type": "object", "additionalProperties": false, "required": ["schema", "authenticated", "complete", "file_count", "total_size", "unexpected_files", "manifest_sha256", "receipt_sha256"], "properties": {"schema": {"const": "vvfp.full-folder-inventory.v1"}, "authenticated": {"type": "boolean"}, "complete": {"type": "boolean"}, "file_count": {"anyOf": [{"type": "integer", "minimum": 1}, {"type": "null"}]}, "total_size": {"anyOf": [{"type": "integer", "minimum": 1}, {"type": "null"}]}, "unexpected_files": {"type": "array", "items": {"type": "string", "minLength": 1}}, "manifest_sha256": {"$ref": "#/$defs/shaOrNull"}, "receipt_sha256": {"$ref": "#/$defs/shaOrNull"}}},
    "record": {"type": "object", "additionalProperties": false, "required": ["count", "stride", "active_offset", "faction_offset", "health_offset", "forbidden_unproved_offset", "exclusion_policy", "read_order", "sickness_offset", "sickness_semantic"], "properties": {"count": {"const": 150}, "stride": {"const": "0x2F44"}, "active_offset": {"const": "0x1CD4"}, "faction_offset": {"const": "0x1CEC"}, "health_offset": {"const": "0x1C40"}, "forbidden_unproved_offset": {"const": "0x1CE1"}, "exclusion_policy": {"const": {"never_read": ["0x1CE1"], "never_write": ["0x1CE1"], "never_use_as_eligibility_guard": ["0x1CE1"], "status": "unproved and excluded"}}, "read_order": {"const": ["active", "faction_equals_zero", "positive_health", "native_sickness"]}, "sickness_offset": {"$ref": "#/$defs/textOrNull"}, "sickness_semantic": {"$ref": "#/$defs/textOrNull"}}},
    "abis": {"type": "object", "additionalProperties": false, "required": ["record_world_resolver", "sickness_clearer", "health_setter", "people_cured", "funds_account"], "properties": {"record_world_resolver": {"type": "object"}, "sickness_clearer": {"type": "object"}, "health_setter": {"type": "object"}, "people_cured": {"type": "object"}, "funds_account": {"type": "object"}}},
    "transaction": {"type": "object", "additionalProperties": false, "required": ["folder_manifest_sha256", "dry_run_artifact_sha256", "confirmation_artifact_sha256", "postverify_artifact_sha256", "partial_rollback_artifact_sha256", "predicted_actual_counts_verified", "overlap_counts_both_verified", "deduction_after_postverify_verified", "partial_effect_boundary_verified", "rollback_disclosure_verified"], "properties": {"folder_manifest_sha256": {"$ref": "#/$defs/shaOrNull"}, "dry_run_artifact_sha256": {"$ref": "#/$defs/shaOrNull"}, "confirmation_artifact_sha256": {"$ref": "#/$defs/shaOrNull"}, "postverify_artifact_sha256": {"$ref": "#/$defs/shaOrNull"}, "partial_rollback_artifact_sha256": {"$ref": "#/$defs/shaOrNull"}, "predicted_actual_counts_verified": {"type": "boolean"}, "overlap_counts_both_verified": {"type": "boolean"}, "deduction_after_postverify_verified": {"type": "boolean"}, "partial_effect_boundary_verified": {"type": "boolean"}, "rollback_disclosure_verified": {"type": "boolean"}}},
    "messages": {"type": "object", "additionalProperties": false, "required": ["label", "prompt", "sick_result", "partial_result", "singular_plural_verified"], "properties": {"label": {"const": "Full Heal / Cure All"}, "prompt": {"type": "string"}, "sick_result": {"type": "string"}, "partial_result": {"type": "string"}, "singular_plural_verified": {"type": "boolean"}}},
    "ui": {"type": "object", "additionalProperties": false, "required": ["resource", "dimensions", "local", "event", "factory_va", "ownership_va", "windowed_receipt_sha256", "fullscreen_receipt_sha256", "owner_verified", "centering_verified", "fullscreen_restore_verified", "child_destructor_verified"], "properties": {"resource": {"const": "0x6A"}, "dimensions": {"const": [96, 39]}, "local": {"const": [137, 2]}, "event": {"const": 13}, "factory_va": {"const": "0x401BD0"}, "ownership_va": {"const": "0x40C680"}, "windowed_receipt_sha256": {"$ref": "#/$defs/shaOrNull"}, "fullscreen_receipt_sha256": {"$ref": "#/$defs/shaOrNull"}, "owner_verified": {"type": "boolean"}, "centering_verified": {"type": "boolean"}, "fullscreen_restore_verified": {"type": "boolean"}, "child_destructor_verified": {"type": "boolean"}}},
    "composition": {"type": "object", "additionalProperties": false, "required": ["origins_range", "full_mastery_range", "running_range", "ui_ranges", "full_heal_ranges", "patches", "hooks", "caves", "overlap_report_sha256", "expanded_rejected", "expanded_lifecycle_verified"], "properties": {"origins_range": {"const": "0xDB000-0xDC000"}, "full_mastery_range": {"const": "0xF2000-0xF4000"}, "running_range": {"const": "0xF4000-0xF6000"}, "ui_ranges": {"const": []}, "full_heal_ranges": {"const": []}, "patches": {"const": []}, "hooks": {"const": []}, "caves": {"const": []}, "overlap_report_sha256": {"$ref": "#/$defs/shaOrNull"}, "expanded_rejected": {"const": true}, "expanded_lifecycle_verified": {"type": "boolean"}}}
  }
}
