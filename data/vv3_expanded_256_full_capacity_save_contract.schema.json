{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "vvfp.vv3_expanded_256_full_capacity_save_contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_version",
    "contract_id",
    "status",
    "enabled",
    "bindings",
    "reference_findings",
    "required_semantics",
    "native_evidence",
    "runtime_fault_matrix",
    "decision",
    "integrity"
  ],
  "properties": {
    "schema": {"const": "vvfp.vv3_expanded_256_full_capacity_save_contract"},
    "schema_version": {"const": 1},
    "contract_id": {"const": "x3-vv3-expanded-256-full-capacity-save-semantics"},
    "status": {"const": "evidence_reference_stop"},
    "enabled": {"const": false},
    "bindings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_sha256",
        "prototype_sha256",
        "c342_dependency",
        "stored_index_gate_sha256",
        "save_abi_gate_sha256",
        "runtime_receipt_schema_sha256"
      ],
      "properties": {
        "source_sha256": {"const": "8BC5DB382D02BC5C21AD5F607580D60FF44A6519CC7EB133F03113BAACAE6503"},
        "prototype_sha256": {"const": "6EE3361A7AC35F441763647C1E2FC9EC49569DE5EF372BDB41D243D03002D601"},
        "c342_dependency": {"const": "28c5fa8ef87212fe79ce3d3e5daee51b0e3ad488"},
        "stored_index_gate_sha256": {"$ref": "#/$defs/sha"},
        "save_abi_gate_sha256": {"$ref": "#/$defs/sha"},
        "runtime_receipt_schema_sha256": {"$ref": "#/$defs/sha"}
      }
    },
    "reference_findings": {"$ref": "#/$defs/reference_findings"},
    "required_semantics": {"$ref": "#/$defs/required_semantics"},
    "native_evidence": {"$ref": "#/$defs/native_evidence"},
    "runtime_fault_matrix": {
      "type": "array",
      "minItems": 12,
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status"],
        "properties": {"id": {"type": "string", "minLength": 1}, "status": {"const": "pending"}}
      }
    },
    "decision": {"const": {"native_bytes_emitted": false, "enabled": false, "runtime_go": false, "player_go": false, "publication_ready": false, "status": "STOP"}},
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["canonical_sha256"],
      "properties": {"canonical_sha256": {"type": ["string", "null"]}}
    }
  },
  "$defs": {
    "sha": {"type": "string", "pattern": "^[0-9A-F]{64}$"},
    "reference_findings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "classification",
        "serializer_ea",
        "deserializer_ea",
        "save_count_ea",
        "writer_helper_ea",
        "record_size",
        "records_offset",
        "logical_first",
        "logical_last",
        "padding_indices",
        "tail_offset",
        "expanded_body_size",
        "expanded_file_size",
        "observed_risk"
      ],
      "properties": {
        "classification": {"const": "D350_D351_unverified_reference_only"},
        "serializer_ea": {"const": "0x45EF80"},
        "deserializer_ea": {"const": "0x45C860"},
        "save_count_ea": {"const": "0x428810"},
        "writer_helper_ea": {"const": "0x45C8D0"},
        "record_size": {"const": "0x11C"},
        "records_offset": {"const": "0x7864"},
        "logical_first": {"const": 0},
        "logical_last": {"const": 255},
        "padding_indices": {"const": [256, 257, 258, 259]},
        "tail_offset": {"const": "0x19464"},
        "expanded_body_size": {"const": "0x1A4B4"},
        "expanded_file_size": {"const": "0x1A4C0"},
        "observed_risk": {"type": "string", "minLength": 1}
      }
    },
    "semantic_list": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "required_semantics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["writer", "reader", "caller", "atomic_writer"],
      "properties": {
        "writer": {"$ref": "#/$defs/semantic_list"},
        "reader": {"$ref": "#/$defs/semantic_list"},
        "caller": {"$ref": "#/$defs/semantic_list"},
        "atomic_writer": {"$ref": "#/$defs/semantic_list"}
      }
    },
    "native_function": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "ea", "function_bounds", "raw_bytes", "complete_xrefs", "artifact_refs"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "ea": {"type": "string", "pattern": "^0x[0-9A-F]+$"},
        "function_bounds": {"const": null},
        "raw_bytes": {"const": null},
        "complete_xrefs": {"const": null},
        "artifact_refs": {"const": []}
      }
    },
    "native_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stock_functions",
        "save_callers",
        "candidate_section_bytes",
        "candidate_hook_bytes",
        "candidate_final_bytes",
        "authenticated_full_folder",
        "status"
      ],
      "properties": {
        "stock_functions": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"$ref": "#/$defs/native_function"}},
        "save_callers": {"const": []},
        "candidate_section_bytes": {"const": null},
        "candidate_hook_bytes": {"const": null},
        "candidate_final_bytes": {"const": null},
        "authenticated_full_folder": {"const": false},
        "status": {"const": "evidence_absent"}
      }
    }
  }
}
