{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "vvfp.vv3_expanded_256_folder_inventory",
  "title": "VV3 Expanded-256 exact complete-folder inventory",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_version",
    "status",
    "complete",
    "synthetic",
    "ambiguous",
    "folder_name",
    "source_sha256",
    "prototype_sha256",
    "exporter_manifest_sha256",
    "exporter_manifest_file_sha256",
    "physical_files",
    "records"
  ],
  "properties": {
    "schema": {"const": "vvfp.vv3_expanded_256_folder_inventory"},
    "schema_version": {"const": 1},
    "status": {"const": "complete"},
    "complete": {"const": true},
    "synthetic": {"const": false},
    "ambiguous": {"const": false},
    "folder_name": {"const": "Virtual Villagers - The Secret City - Modded 256"},
    "source_sha256": {"const": "8BC5DB382D02BC5C21AD5F607580D60FF44A6519CC7EB133F03113BAACAE6503"},
    "prototype_sha256": {"const": "6EE3361A7AC35F441763647C1E2FC9EC49569DE5EF372BDB41D243D03002D601"},
    "exporter_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "exporter_manifest_file_sha256": {"$ref": "#/$defs/sha256"},
    "physical_files": {"const": 419},
    "records": {
      "type": "array",
      "minItems": 419,
      "maxItems": 419,
      "items": {"$ref": "#/$defs/record"}
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9A-F]{64}$"},
    "catalog_path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^\\\\/:*?\"<>|\\u0000-\\u001F]+(?:/[^\\\\/:*?\"<>|\\u0000-\\u001F]+)*$",
      "not": {"pattern": "(^|/)(\\.|\\.\\.)(/|$)"}
    },
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "role", "size", "sha256"],
      "properties": {
        "path": {"$ref": "#/$defs/catalog_path"},
        "role": {
          "enum": [
            "stock_executable",
            "retained_game_asset",
            "entry_executable",
            "companion_dll",
            "patch_log",
            "transparency_log",
            "player_readme",
            "runtime_inventory",
            "checksum_list"
          ]
        },
        "size": {"type": "integer", "minimum": 0},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
