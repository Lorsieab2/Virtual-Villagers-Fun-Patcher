#define DS_MODALFRAME 0x0080L
#define DS_SETFONT 0x0040L
#define WS_POPUP 0x80000000L
#define WS_CAPTION 0x00C00000L
#define WS_SYSMENU 0x00080000L
#ifndef WS_THICKFRAME
#define WS_THICKFRAME 0x00040000L
#endif
#ifndef WS_MINIMIZEBOX
#define WS_MINIMIZEBOX 0x00020000L
#endif
#ifndef WS_MAXIMIZEBOX
#define WS_MAXIMIZEBOX 0x00010000L
#endif
#define WS_CHILD 0x40000000L
#define WS_VISIBLE 0x10000000L
#define SS_CENTER 0x00000001L
#define SS_OWNERDRAW 0x0000000DL
#define DS_CENTER 0x00000800L
#define WS_GROUP 0x00020000L
#define WS_TABSTOP 0x00010000L

201 DIALOGEX 0, 0, 612, 313
STYLE DS_MODALFRAME | DS_SETFONT | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_THICKFRAME | WS_MINIMIZEBOX | WS_MAXIMIZEBOX
CAPTION "Origins Upgrades"
FONT 9, "Segoe UI"
BEGIN
    /* LEFT COLUMN: rows 0-6.  icon x=8, badge x=22, text x=40, Buy x=240. */
    ICON 101, -1, 8, 6, 24, 24
    ICON 109, 1100, 22, 14, 12, 12
    LTEXT "Time Warp - Advances the Village Clock", -1, 40, 7, 195, 10
    LTEXT "50,000 tech points", -1, 40, 19, 195, 9
    PUSHBUTTON "Buy", 1000, 240, 8, 55, 18

    ICON 102, -1, 8, 33, 24, 24
    ICON 109, 1101, 22, 41, 12, 12
    LTEXT "Island Event", -1, 40, 34, 195, 10
    LTEXT "30,000 tech points", -1, 40, 46, 195, 9
    PUSHBUTTON "Buy", 1001, 240, 35, 55, 18

    ICON 103, -1, 8, 60, 24, 24
    ICON 109, 1102, 22, 68, 12, 12
    LTEXT "Barrel of Babies", -1, 40, 61, 195, 10
    LTEXT "75,000 tech points", -1, 40, 73, 195, 9
    PUSHBUTTON "Buy", 1002, 240, 62, 55, 18

    ICON 104, -1, 8, 87, 24, 24
    ICON 109, 1103, 22, 95, 12, 12
    LTEXT "Tech Point Doubler", -1, 40, 88, 195, 10
    LTEXT "500,000 tech points", -1, 40, 100, 195, 9
    PUSHBUTTON "Buy", 1003, 240, 89, 55, 18

    ICON 105, -1, 8, 114, 24, 24
    ICON 109, 1104, 22, 122, 12, 12
    LTEXT "Food Point Doubler", -1, 40, 115, 195, 10
    LTEXT "500,000 tech points", -1, 40, 127, 195, 9
    PUSHBUTTON "Buy", 1004, 240, 116, 55, 18

    ICON 110, -1, 8, 141, 24, 24
    ICON 109, 1105, 22, 149, 12, 12
    LTEXT "Full Heal / Cure All", -1, 40, 142, 195, 10
    LTEXT "30,000 tech points", -1, 40, 154, 195, 9
    PUSHBUTTON "Buy", 1005, 240, 143, 55, 18

    ICON 108, -1, 8, 168, 24, 24
    ICON 109, 1106, 22, 176, 12, 12
    LTEXT "Grant Running to All Villagers", -1, 40, 169, 195, 10
    LTEXT "1,000,000 tech points", -1, 40, 181, 195, 9
    PUSHBUTTON "Buy", 1006, 240, 170, 55, 18

    /* RIGHT COLUMN: rows 7-16 (x = left + 302).  icon x=310, badge x=324,
       text x=342, Buy x=542.  Icons+badges on every row (reusing the existing
       icon resources), matching the owner's preference. */
    ICON 107, -1, 310, 6, 24, 24
    ICON 109, 1107, 324, 14, 12, 12
    LTEXT "Grant Full Mastery to All Villagers", -1, 342, 7, 195, 10
    LTEXT "1,000,000 tech points", -1, 342, 19, 195, 9
    PUSHBUTTON "Buy", 1007, 542, 8, 55, 18

    ICON 106, -1, 310, 33, 24, 24
    ICON 109, 1108, 324, 41, 12, 12
    LTEXT "All Villagers are Exactly 18", -1, 342, 34, 195, 10
    LTEXT "1,000,000 tech points", -1, 342, 46, 195, 9
    PUSHBUTTON "Buy", 1008, 542, 35, 55, 18

    ICON 104, -1, 310, 60, 24, 24
    ICON 109, 1109, 324, 68, 12, 12
    LTEXT "Complete All Collections", -1, 342, 61, 195, 10
    LTEXT "1,000,000 tech points", -1, 342, 73, 195, 9
    PUSHBUTTON "Buy", 1009, 542, 62, 55, 18

    ICON 105, -1, 310, 87, 24, 24
    ICON 109, 1110, 324, 95, 12, 12
    LTEXT "Reset All Collections", -1, 342, 88, 195, 10
    LTEXT "1,000,000 tech points", -1, 342, 100, 195, 9
    PUSHBUTTON "Buy", 1010, 542, 89, 55, 18

    ICON 107, -1, 310, 114, 24, 24
    ICON 109, 1111, 324, 122, 12, 12
    LTEXT "Equal Division of Labor (Includes Parenting)", -1, 342, 115, 195, 10
    LTEXT "1,000,000 tech points", -1, 342, 127, 195, 9
    PUSHBUTTON "Buy", 1011, 542, 116, 55, 18

    ICON 106, -1, 310, 141, 24, 24
    ICON 109, 1112, 324, 149, 12, 12
    LTEXT "Equal Division of Labor (No Parenting)", -1, 342, 142, 195, 10
    LTEXT "1,000,000 tech points", -1, 342, 154, 195, 9
    PUSHBUTTON "Buy", 1012, 542, 143, 55, 18

    ICON 108, -1, 310, 168, 24, 24
    ICON 109, 1113, 324, 176, 12, 12
    LTEXT "Clear All Skill Preferences", -1, 342, 169, 195, 10
    LTEXT "500,000 tech points", -1, 342, 181, 195, 9
    PUSHBUTTON "Buy", 1013, 542, 170, 55, 18

    ICON 107, -1, 310, 195, 24, 24
    ICON 109, 1114, 324, 203, 12, 12
    LTEXT "Check Highest Skill (Includes Parenting)", -1, 342, 196, 195, 10
    LTEXT "1,000,000 tech points", -1, 342, 208, 195, 9
    PUSHBUTTON "Buy", 1014, 542, 197, 55, 18

    ICON 106, -1, 310, 222, 24, 24
    ICON 109, 1115, 324, 230, 12, 12
    LTEXT "Check Highest Skill (No Parenting)", -1, 342, 223, 195, 10
    LTEXT "1,000,000 tech points", -1, 342, 235, 195, 9
    PUSHBUTTON "Buy", 1015, 542, 224, 55, 18

    ICON 106, -1, 310, 249, 24, 24
    ICON 109, 1116, 324, 257, 12, 12
    LTEXT "Change Appearance for All", -1, 342, 250, 195, 10
    LTEXT "450,000 tech points", -1, 342, 262, 195, 9
    PUSHBUTTON "Buy", 1016, 542, 251, 55, 18

    CTEXT "Press ESC to exit this menu.", -1, 10, 281, 592, 9
    DEFPUSHBUTTON "Cancel", 2, 271, 293, 70, 14
END

202 DIALOGEX 0, 0, 310, 204
STYLE DS_MODALFRAME | DS_SETFONT | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_THICKFRAME | WS_MINIMIZEBOX | WS_MAXIMIZEBOX
CAPTION "Villager Upgrades"
