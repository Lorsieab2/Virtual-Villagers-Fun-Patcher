    AUTORADIOBUTTON "VV5-style (1 Chief, 4 Purple, up to 7 Red, up to 10 Orange, rest Blue)", 3231, 14, 276, 288, 10
    AUTORADIOBUTTON "Random (All 5 + No Mask)", 3232, 14, 289, 288, 10
    AUTORADIOBUTTON "Random (All 5)", 3234, 318, 263, 288, 10
    AUTORADIOBUTTON "Equal Colors (All 5 colors; balanced M/F)", 3233, 318, 276, 288, 10

    LTEXT       "Head look:", 3525, 14, 108, 40, 9
