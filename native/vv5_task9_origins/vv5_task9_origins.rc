    AUTORADIOBUTTON "Blue", 3242, 390, 194, 116, 10
    AUTORADIOBUTTON "Orange", 3243, 390, 207, 116, 10
    AUTORADIOBUTTON "Red", 3244, 508, 181, 100, 10
    AUTORADIOBUTTON "Purple", 3245, 508, 194, 100, 10
    AUTORADIOBUTTON "Chief", 3246, 508, 207, 100, 10

    GROUPBOX        "Mask Distribution (all villagers)", -1, 6, 250, 608, 56
