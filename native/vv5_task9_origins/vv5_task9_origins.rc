    AUTORADIOBUTTON "All Brown Hair", 3253, 390, 53, 216, 10
    AUTORADIOBUTTON "All Red / Ginger Hair", 3254, 390, 66, 216, 10
    AUTORADIOBUTTON "All Blonde Hair", 3255, 390, 79, 216, 10
    AUTORADIOBUTTON "All Other Hair / Styles", 3256, 390, 92, 216, 10

    GROUPBOX        "Village-wide Bodies", -1, 382, 126, 232, 40
    AUTORADIOBUTTON "Off (use Body selectors above)", 3260, 390, 138, 216, 10, WS_GROUP | WS_TABSTOP
    AUTORADIOBUTTON "Random (by gender)", 3261, 390, 151, 216, 10

    GROUPBOX        "Village-wide Single Mask Color", -1, 382, 168, 232, 78
