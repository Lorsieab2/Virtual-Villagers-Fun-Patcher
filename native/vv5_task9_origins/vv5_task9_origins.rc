    LTEXT "Set Age to 18", -1, 40, 106, 150, 10
    LTEXT "50,000 tech points", -1, 40, 118, 150, 9
    PUSHBUTTON "Buy", 1003, 240, 107, 55, 18

    ICON 106, -1, 8, 136, 24, 24
    ICON 109, 1104, 22, 148, 12, 12
    LTEXT "Change Appearance", -1, 40, 138, 195, 10
    LTEXT "5,000 tech points", -1, 40, 150, 150, 9
    PUSHBUTTON "Buy", 1004, 240, 139, 55, 18

    CTEXT "Press ESC to exit this menu.", -1, 10, 190, 290, 9
    DEFPUSHBUTTON "Cancel", 2, 120, 170, 70, 14
END

203 DIALOGEX 0, 0, 364, 248
STYLE DS_MODALFRAME | DS_SETFONT | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_THICKFRAME | WS_MINIMIZEBOX | WS_MAXIMIZEBOX
CAPTION "Change Appearance"
FONT 9, "Segoe UI"
BEGIN
    CTEXT       "Body", -1, 30, 8, 70, 9
    CONTROL     "", 3101, "STATIC", SS_OWNERDRAW | WS_CHILD | WS_VISIBLE, 30, 20, 70, 118
    PUSHBUTTON  "<", 3103, 10, 72, 16, 16
    PUSHBUTTON  ">", 3104, 104, 72, 16, 16

    CTEXT       "Head", -1, 150, 8, 70, 9
    CONTROL     "", 3102, "STATIC", SS_OWNERDRAW | WS_CHILD | WS_VISIBLE, 150, 20, 70, 118
    PUSHBUTTON  "<", 3105, 130, 72, 16, 16
    PUSHBUTTON  ">", 3106, 224, 72, 16, 16

    CTEXT       "Mask", -1, 270, 8, 70, 9
    CONTROL     "", 3110, "STATIC", SS_OWNERDRAW | WS_CHILD | WS_VISIBLE, 270, 20, 70, 118
    PUSHBUTTON  "<", 3108, 250, 72, 16, 16
    PUSHBUTTON  ">", 3109, 344, 72, 16, 16
    CTEXT       "(None)", 3107, 270, 140, 70, 10

    GROUPBOX        "Randomize", -1, 16, 152, 332, 44
    PUSHBUTTON  "Random head", 3502, 24, 163, 66, 13
    PUSHBUTTON  "Random body", 3503, 94, 163, 66, 13
    PUSHBUTTON  "Random mask", 3504, 164, 163, 66, 13
    LTEXT       "Head by hair colour:", -1, 24, 180, 70, 9
    PUSHBUTTON  "Black", 3510, 96, 178, 40, 13
    PUSHBUTTON  "Brown", 3511, 140, 178, 40, 13
    PUSHBUTTON  "Red / Ginger", 3512, 184, 178, 54, 13
    PUSHBUTTON  "Blonde", 3513, 242, 178, 40, 13
    PUSHBUTTON  "Other", 3514, 286, 178, 40, 13

    CTEXT       "OK deducts 5,000 tech points. Cancel changes nothing.", -1, 16, 202, 332, 9
    PUSHBUTTON  "Undo changes", 3500, 16, 220, 64, 16
    PUSHBUTTON  "Reset to original", 3501, 84, 220, 78, 16
    DEFPUSHBUTTON "OK", 1, 236, 220, 54, 16
    PUSHBUTTON  "Cancel", 2, 294, 220, 54, 16
END

/* Change Appearance with the head look (native/shared/head_look.h): 203 and, below the three pickers, a
   "Head look" row -- Auto, Young or Old.  Used when "VVFP Head Look.dll" is in the game and the selected
   villager is found; otherwise 203 as it was. */
208 DIALOGEX 0, 0, 364, 274
STYLE DS_MODALFRAME | DS_SETFONT | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_THICKFRAME | WS_MINIMIZEBOX | WS_MAXIMIZEBOX
CAPTION "Change Appearance"
FONT 9, "Segoe UI"
BEGIN
    CTEXT       "Body", -1, 30, 8, 70, 9
    CONTROL     "", 3101, "STATIC", SS_OWNERDRAW | WS_CHILD | WS_VISIBLE, 30, 20, 70, 118
    PUSHBUTTON  "<", 3103, 10, 72, 16, 16
    PUSHBUTTON  ">", 3104, 104, 72, 16, 16

    CTEXT       "Head", -1, 150, 8, 70, 9
    CONTROL     "", 3102, "STATIC", SS_OWNERDRAW | WS_CHILD | WS_VISIBLE, 150, 20, 70, 118
    PUSHBUTTON  "<", 3105, 130, 72, 16, 16
    PUSHBUTTON  ">", 3106, 224, 72, 16, 16

    CTEXT       "Mask", -1, 270, 8, 70, 9
    CONTROL     "", 3110, "STATIC", SS_OWNERDRAW | WS_CHILD | WS_VISIBLE, 270, 20, 70, 118
    PUSHBUTTON  "<", 3108, 250, 72, 16, 16
    PUSHBUTTON  ">", 3109, 344, 72, 16, 16
    CTEXT       "(None)", 3107, 270, 140, 70, 10

    GROUPBOX        "Head look", -1, 16, 152, 332, 26
    AUTORADIOBUTTON "Auto (old from 55)", 3120, 30, 164, 100, 10, WS_GROUP | WS_TABSTOP
    AUTORADIOBUTTON "Young", 3121, 160, 164, 60, 10
    AUTORADIOBUTTON "Old", 3122, 250, 164, 34, 10

    PUSHBUTTON  "Random", 3505, 290, 161, 50, 13
    GROUPBOX        "Randomize", -1, 16, 186, 332, 44
    PUSHBUTTON  "Random head", 3502, 24, 197, 66, 13
    PUSHBUTTON  "Random body", 3503, 94, 197, 66, 13
    PUSHBUTTON  "Random mask", 3504, 164, 197, 66, 13
    LTEXT       "Head by hair colour:", -1, 24, 214, 70, 9
    PUSHBUTTON  "Black", 3510, 96, 212, 40, 13
    PUSHBUTTON  "Brown", 3511, 140, 212, 40, 13
    PUSHBUTTON  "Red / Ginger", 3512, 184, 212, 54, 13
    PUSHBUTTON  "Blonde", 3513, 242, 212, 40, 13
    PUSHBUTTON  "Other", 3514, 286, 212, 40, 13

    CTEXT       "OK deducts 5,000 tech points, for the head look too. Cancel changes nothing.", -1, 16, 236, 332, 9
    PUSHBUTTON  "Undo changes", 3500, 16, 250, 64, 16
    PUSHBUTTON  "Reset to original", 3501, 84, 250, 78, 16
    DEFPUSHBUTTON "OK", 1, 236, 250, 54, 16
    PUSHBUTTON  "Cancel", 2, 294, 250, 54, 16
END

214 DIALOGEX 0, 0, 620, 348
STYLE DS_MODALFRAME | DS_SETFONT | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_THICKFRAME | WS_MINIMIZEBOX | WS_MAXIMIZEBOX
CAPTION "Change Appearance for All"
FONT 9, "Segoe UI"
BEGIN
    GROUPBOX    "Male Villagers", -1, 6, 2, 368, 120
    CTEXT       "Body", -1, 28, 14, 50, 9
    PUSHBUTTON  "<", 3211, 14, 48, 12, 20
    CONTROL     "", 3201, "STATIC", SS_OWNERDRAW | WS_CHILD | WS_VISIBLE, 28, 24, 50, 74
    PUSHBUTTON  ">", 3221, 80, 48, 12, 20
    CTEXT       "Head", -1, 150, 14, 50, 9
    PUSHBUTTON  "<", 3212, 136, 48, 12, 20
    CONTROL     "", 3202, "STATIC", SS_OWNERDRAW | WS_CHILD | WS_VISIBLE, 150, 24, 50, 74
    PUSHBUTTON  ">", 3222, 202, 48, 12, 20
