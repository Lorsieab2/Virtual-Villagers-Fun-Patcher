/* VV2 Origins icons: VV2-only dialog resources. The shared icons (101-110)
   come from the included base resource; every dialog VV2 actually uses is
   defined here with VV2-specific IDs (211 tech, 212 villager, 213 Change
   Appearance) so nothing collides with the shared/other-game resources.

   VVFP_VV2_BUILD skips VV1's own Change Appearance bitmaps (3001/3002/
   3011/3012 -- the same IDs VV2's own set below reuses) and VV1's own
   dialog 203, neither of which VV2 uses (see the matching guards in
   vv1_origins_icons.rc for why). Must be defined before the #include. */
#define VVFP_VV2_BUILD
#include "../vv1_origins_icons/vv1_origins_icons.rc"

3001 BITMAP "appearance/head_m_young.bmp"
3002 BITMAP "appearance/head_m_old.bmp"
3003 BITMAP "appearance/head_f_young.bmp"
3004 BITMAP "appearance/head_f_old.bmp"
3011 BITMAP "appearance/body_m.bmp"
3012 BITMAP "appearance/body_f.bmp"
3020 BITMAP "appearance/mask_preview.bmp"   /* 6 cells: none + 5 masks, 40x65 each */
/* the mask render atlas, embedded so the DLL self-extracts it to <game>\Images\
   heathen_masks.png at startup (or migrates one exact obsolete 320x440 bundle),
   while preserving current/custom art -- no manual asset copy. */
5000 RCDATA "heathen_masks.png"

#define WS_CHILD      0x40000000L
#define WS_VISIBLE    0x10000000L
#define SS_CENTER     0x00000001L
#define SS_OWNERDRAW  0x0000000DL
#define DS_CENTER     0x00000800L
#define WS_GROUP      0x00020000L
#define WS_TABSTOP    0x00010000L

/* VV2 Tech-screen upgrades, laid out in TWO COLUMNS so the 14 rows fit on-screen
   (the single-column list ran off the bottom once "Change Appearance for All" was
   added).  Left column = rows 0-6, right column = rows 7-13 (X base +302).  Row
   IDs are unchanged: Buy button = 1000+row, satisfied badge = ID_CHECK_FIRST+row
   (rows 0-8 only).  vv2_upgrade_dialog / VV2_TECH_ROW_COUNT drive visibility. */
211 DIALOGEX 0, 0, 612, 232
STYLE DS_MODALFRAME | DS_SETFONT | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Origins Upgrades"
FONT 9, "Segoe UI"
BEGIN
    /* ---- left column: rows 0-6 ---- */
    ICON        101, -1, 8,   6,  24, 24
    ICON        109, 1100, 22, 18, 12, 12
    LTEXT       "Time Warp - Advances the Village Clock", -1, 40, 8, 195, 10
    LTEXT       "50,000 tech points", -1, 40, 20, 150, 9
    PUSHBUTTON  "Buy", 1000, 240, 9, 55, 18

    ICON        102, -1, 8,  33,  24, 24
    ICON        109, 1101, 22, 45, 12, 12
    LTEXT       "Island Event", -1, 40, 35, 150, 10
    LTEXT       "30,000 tech points", -1, 40, 47, 150, 9
    PUSHBUTTON  "Buy", 1001, 240, 36, 55, 18

    ICON        103, -1, 8,  60,  24, 24
    ICON        109, 1102, 22, 72, 12, 12
    LTEXT       "Barrel of Babies", -1, 40, 62, 150, 10
    LTEXT       "75,000 tech points", -1, 40, 74, 150, 9
    PUSHBUTTON  "Buy", 1002, 240, 63, 55, 18

    ICON        104, -1, 8, 87,  24, 24
    ICON        109, 1103, 22, 99, 12, 12
    LTEXT       "Tech Point Doubler", -1, 40, 89, 150, 10
    LTEXT       "500,000 tech points", -1, 40, 101, 150, 9
    PUSHBUTTON  "Buy", 1003, 240, 90, 55, 18

    ICON        105, -1, 8, 114,  24, 24
    ICON        109, 1104, 22, 126, 12, 12
    LTEXT       "Food Point Doubler", -1, 40, 116, 150, 10
    LTEXT       "500,000 tech points", -1, 40, 128, 150, 9
    PUSHBUTTON  "Buy", 1004, 240, 117, 55, 18

    ICON        110, -1, 8, 141,  24, 24
    ICON        109, 1105, 22, 153, 12, 12
    LTEXT       "Full Heal / Cure All", -1, 40, 143, 190, 10
    LTEXT       "30,000 tech points", -1, 40, 155, 150, 9
    PUSHBUTTON  "Buy", 1005, 240, 144, 55, 18

    ICON        108, -1, 8, 168,  24, 24
    ICON        109, 1106, 22, 180, 12, 12
    LTEXT       "Grant Running to All Villagers", -1, 40, 170, 190, 10
    LTEXT       "1,000,000 tech points", -1, 40, 182, 170, 9
    PUSHBUTTON  "Buy", 1006, 240, 171, 55, 18

    /* ---- right column: rows 7-13 (X base +302) ---- */
    ICON        107, -1, 310, 6,  24, 24
    ICON        109, 1107, 324, 18, 12, 12
    LTEXT       "Grant Full Mastery to All Villagers", -1, 342, 8, 190, 10
    LTEXT       "1,000,000 tech points", -1, 342, 20, 170, 9
    PUSHBUTTON  "Buy", 1007, 542, 9, 55, 18

    ICON        106, -1, 310, 33,  24, 24
    ICON        109, 1108, 324, 45, 12, 12
    LTEXT       "All Villagers are Exactly 18", -1, 342, 35, 190, 10
    LTEXT       "1,000,000 tech points", -1, 342, 47, 170, 9
    PUSHBUTTON  "Buy", 1008, 542, 36, 55, 18

    ICON        104, -1, 310, 60,  24, 24
    LTEXT       "Complete All Collections", -1, 342, 62, 190, 10
    LTEXT       "1,000,000 tech points", -1, 342, 74, 170, 9
    PUSHBUTTON  "Buy", 1009, 542, 63, 55, 18

    ICON        105, -1, 310, 87,  24, 24
    LTEXT       "Reset All Collections", -1, 342, 89, 190, 10
    LTEXT       "1,000,000 tech points", -1, 342, 101, 170, 9
    PUSHBUTTON  "Buy", 1010, 542, 90, 55, 18

    ICON        107, -1, 310, 114,  24, 24
    LTEXT       "Equal Division of Labor (Includes Parenting)", -1, 342, 116, 195, 10
    LTEXT       "1,000,000 tech points", -1, 342, 128, 170, 9
    PUSHBUTTON  "Buy", 1011, 542, 117, 55, 18

    ICON        108, -1, 310, 141,  24, 24
    LTEXT       "Equal Division of Labor (No Parenting)", -1, 342, 143, 195, 10
    LTEXT       "1,000,000 tech points", -1, 342, 155, 170, 9
    PUSHBUTTON  "Buy", 1012, 542, 144, 55, 18

    ICON        106, -1, 310, 168,  24, 24
    LTEXT       "Change Appearance for All", -1, 342, 170, 195, 10
    LTEXT       "450,000 tech points", -1, 342, 182, 170, 9
    PUSHBUTTON  "Buy", 1013, 542, 171, 55, 18

    CTEXT       "Press ESC to exit this menu.", -1, 10, 200, 592, 9
    DEFPUSHBUTTON "Cancel", 2, 271, 212, 70, 14
END

/* VV2 Villager Details upgrades (four per-villager rows + Change Appearance). */
212 DIALOGEX 0, 0, 310, 204
STYLE DS_MODALFRAME | DS_SETFONT | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Villager Upgrades"
FONT 9, "Segoe UI"
BEGIN
    ICON        106, -1, 8,  8,  24, 24
    ICON        109, 1100, 22, 20, 12, 12
    LTEXT       "Grant Youth (-35 years, min age 5)", -1, 40, 10, 195, 10
    LTEXT       "50,000 tech points", -1, 40, 22, 150, 9
    PUSHBUTTON  "Buy", 1000, 240, 11, 55, 18

    ICON        107, -1, 8, 40,  24, 24
    ICON        109, 1101, 22, 52, 12, 12
    LTEXT       "Grant Full Mastery", -1, 40, 42, 150, 10
    LTEXT       "100,000 tech points", -1, 40, 54, 150, 9
    PUSHBUTTON  "Buy", 1001, 240, 43, 55, 18

    ICON        108, -1, 8, 72,  24, 24
    ICON        109, 1102, 22, 84, 12, 12
    LTEXT       "Grant Running", -1, 40, 74, 150, 10
    LTEXT       "40,000 tech points", -1, 40, 86, 150, 9
    PUSHBUTTON  "Buy", 1002, 240, 75, 55, 18

    ICON        106, -1, 8, 104,  24, 24
    ICON        109, 1103, 22, 116, 12, 12
    LTEXT       "Set Age to 18", -1, 40, 106, 150, 10
    LTEXT       "50,000 tech points", -1, 40, 118, 150, 9
    PUSHBUTTON  "Buy", 1003, 240, 107, 55, 18

    ICON        106, -1, 8, 136,  24, 24
    LTEXT       "Change Appearance", -1, 40, 138, 190, 10
    LTEXT       "5,000 tech points", -1, 40, 150, 150, 9
    PUSHBUTTON  "Buy", 1004, 240, 139, 55, 18

    DEFPUSHBUTTON "Cancel", 2, 120, 170, 70, 14
    CTEXT       "Press ESC to exit this menu.", -1, 10, 190, 290, 9
END

/* VV2 Change Appearance chooser: sprite previews cropped from the stock art. */
213 DIALOGEX 0, 0, 364, 196
STYLE DS_MODALFRAME | DS_SETFONT | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Change Appearance"
FONT 9, "Segoe UI"
BEGIN
    CTEXT       "Body", -1, 30, 8, 70, 9
    CONTROL     "", 3101, "STATIC", SS_OWNERDRAW | WS_CHILD | WS_VISIBLE, 30, 20, 70, 118
    PUSHBUTTON  "<", 3103, 10, 72, 16, 16
    PUSHBUTTON  ">", 3104, 104, 72, 16, 16

    CTEXT       "Head", -1, 150, 8, 70, 9
    CONTROL     "", 3102, "STATIC", SS_OWNERDRAW | WS_CHILD | WS_VISIBLE, 150, 20, 70, 118
    PUSHBUTTON  "<", 3105, 130, 72, 16, 16
    PUSHBUTTON  ">", 3106, 224, 72, 16, 16

    CTEXT       "Mask", -1, 270, 8, 70, 9
    CONTROL     "", 3107, "STATIC", SS_OWNERDRAW | WS_CHILD | WS_VISIBLE, 270, 20, 70, 118
    PUSHBUTTON  "<", 3108, 250, 72, 16, 16
    PUSHBUTTON  ">", 3109, 344, 72, 16, 16

    CTEXT       "OK deducts 5,000 tech points. Cancel changes nothing.", -1, 16, 150, 332, 9
    DEFPUSHBUTTON "OK", 1, 128, 168, 50, 16
    PUSHBUTTON  "Cancel", 2, 196, 168, 50, 16
END

/* VV2 "Change Appearance for All" (214): per-sex Head/Body/Mask selectors (each
   cycles a "No change" state + the stock options), plus a mutually-exclusive
   mask Distribution preset and a mutually-exclusive Village-wide single mask.
   Preview controls 3201-3206 (male body/head/mask, female body/head/mask);
   cycler buttons 3211-3216 (prev) / 3221-3226 (next). */
214 DIALOGEX 0, 0, 620, 340
STYLE DS_MODALFRAME | DS_SETFONT | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Change Appearance for All"
FONT 9, "Segoe UI"
BEGIN
    /* ---- Male villagers ---- */
    GROUPBOX    "Male Villagers", -1, 6, 2, 368, 104
    CTEXT       "Body", -1, 28, 14, 50, 9
    PUSHBUTTON  "<", 3211, 14, 48, 12, 20
    CONTROL     "", 3201, "STATIC", SS_OWNERDRAW | WS_CHILD | WS_VISIBLE, 28, 24, 50, 74
    PUSHBUTTON  ">", 3221, 80, 48, 12, 20
    CTEXT       "Head", -1, 150, 14, 50, 9
    PUSHBUTTON  "<", 3212, 136, 48, 12, 20
    CONTROL     "", 3202, "STATIC", SS_OWNERDRAW | WS_CHILD | WS_VISIBLE, 150, 24, 50, 74
    PUSHBUTTON  ">", 3222, 202, 48, 12, 20
    CTEXT       "Mask", -1, 272, 14, 50, 9
    PUSHBUTTON  "<", 3213, 258, 48, 12, 20
    CONTROL     "", 3203, "STATIC", SS_OWNERDRAW | WS_CHILD | WS_VISIBLE, 272, 24, 50, 74
    PUSHBUTTON  ">", 3223, 324, 48, 12, 20

    /* ---- Female villagers ---- */
    GROUPBOX    "Female Villagers", -1, 6, 110, 368, 104
    CTEXT       "Body", -1, 28, 122, 50, 9
    PUSHBUTTON  "<", 3214, 14, 156, 12, 20
    CONTROL     "", 3204, "STATIC", SS_OWNERDRAW | WS_CHILD | WS_VISIBLE, 28, 132, 50, 74
    PUSHBUTTON  ">", 3224, 80, 156, 12, 20
    CTEXT       "Head", -1, 150, 122, 50, 9
    PUSHBUTTON  "<", 3215, 136, 156, 12, 20
    CONTROL     "", 3205, "STATIC", SS_OWNERDRAW | WS_CHILD | WS_VISIBLE, 150, 132, 50, 74
    PUSHBUTTON  ">", 3225, 202, 156, 12, 20
    CTEXT       "Mask", -1, 272, 122, 50, 9
    PUSHBUTTON  "<", 3216, 258, 156, 12, 20
    CONTROL     "", 3206, "STATIC", SS_OWNERDRAW | WS_CHILD | WS_VISIBLE, 272, 132, 50, 74
    PUSHBUTTON  ">", 3226, 324, 156, 12, 20

    /* Village-wide override groups in a right column beside the panels (Heads,
       Bodies, Single Mask Color), plus the wide Mask-Distribution row (long
       labels) spanning the full width below.  Each group is one mutually-
       exclusive radio set (enforced in code) that greys its per-sex cyclers. */
    GROUPBOX    "Village-wide Heads", -1, 382, 2, 232, 104
    AUTORADIOBUTTON "Off (use Head selectors above)", 3250, 390, 16, 216, 10, WS_GROUP | WS_TABSTOP
    AUTORADIOBUTTON "Random (by gender)", 3251, 390, 28, 216, 10
    AUTORADIOBUTTON "All Black Hair", 3252, 390, 40, 216, 10
    AUTORADIOBUTTON "All Brown Hair", 3253, 390, 52, 216, 10
    AUTORADIOBUTTON "All Red / Ginger Hair", 3254, 390, 64, 216, 10
    AUTORADIOBUTTON "All Blonde Hair", 3255, 390, 76, 216, 10
    AUTORADIOBUTTON "All Other Hair / Styles", 3256, 390, 88, 216, 10

    GROUPBOX    "Village-wide Bodies", -1, 382, 110, 232, 40
    AUTORADIOBUTTON "Off (use Body selectors above)", 3260, 390, 124, 216, 10, WS_GROUP | WS_TABSTOP
    AUTORADIOBUTTON "Random (by gender)", 3261, 390, 136, 216, 10

    GROUPBOX    "Village-wide Single Mask Color", -1, 382, 152, 232, 62
    AUTORADIOBUTTON "None (remove all masks)", 3241, 390, 166, 110, 10
    AUTORADIOBUTTON "Blue", 3242, 390, 180, 110, 10
    AUTORADIOBUTTON "Orange", 3243, 390, 194, 110, 10
    AUTORADIOBUTTON "Red", 3244, 504, 166, 100, 10
    AUTORADIOBUTTON "Purple", 3245, 504, 180, 100, 10
    AUTORADIOBUTTON "Chief", 3246, 504, 194, 100, 10

    GROUPBOX    "Mask Distribution (all villagers)", -1, 6, 218, 608, 80
    AUTORADIOBUTTON "Off (use Mask selectors above)", 3230, 14, 232, 596, 10, WS_GROUP | WS_TABSTOP
    AUTORADIOBUTTON "VV5-style (1 Chief, 4 Purple, up to 7 Red, up to 10 Orange, rest Blue)", 3231, 14, 246, 596, 10
    AUTORADIOBUTTON "Random (All 5 + No Mask)", 3232, 14, 260, 596, 10
    AUTORADIOBUTTON "Random (All 5)", 3234, 14, 274, 596, 10
    AUTORADIOBUTTON "Equal Colors (All 5 colors; balanced M/F)", 3233, 14, 288, 596, 10

    CTEXT       "OK deducts 450,000 tech points. Cancel changes nothing.", -1, 6, 306, 608, 9, WS_GROUP
    DEFPUSHBUTTON "OK", 1, 250, 318, 50, 16
    PUSHBUTTON  "Cancel", 2, 316, 318, 50, 16
END
