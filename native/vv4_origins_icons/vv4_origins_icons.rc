    LTEXT       "1,000,000 tech points", -1, 40, 236, 170, 9
    PUSHBUTTON  "Buy", 1008, 240, 225, 55, 18

    /* Right column (rows 9-16): the three skill-preference rows (13-15)
       follow the two Equal Division of Labor rows. */
    ICON        110, -1, 310, 6, 24, 24
    ICON        109, 1109, 324, 18, 12, 12
    LTEXT       "Complete All Collections", -1, 342, 8, 195, 10
    LTEXT       "1,000,000 tech points", -1, 342, 20, 170, 9
    PUSHBUTTON  "Buy", 1009, 542, 9, 55, 18

    ICON        108, -1, 310, 33, 24, 24
    ICON        109, 1110, 324, 45, 12, 12
    LTEXT       "Reset All Collections", -1, 342, 35, 195, 10
    LTEXT       "1,000,000 tech points", -1, 342, 47, 170, 9
    PUSHBUTTON  "Buy", 1010, 542, 36, 55, 18

    ICON        107, -1, 310, 60, 24, 24
    ICON        109, 1111, 324, 72, 12, 12
    LTEXT       "Equal Division of Labor (Includes Parenting)", -1, 342, 62, 195, 10
    LTEXT       "1,000,000 tech points", -1, 342, 74, 170, 9
    PUSHBUTTON  "Buy", 1011, 542, 63, 55, 18

    ICON        106, -1, 310, 87, 24, 24
    ICON        109, 1112, 324, 99, 12, 12
    LTEXT       "Equal Division of Labor (No Parenting)", -1, 342, 89, 195, 10
    LTEXT       "1,000,000 tech points", -1, 342, 101, 170, 9
    PUSHBUTTON  "Buy", 1012, 542, 90, 55, 18

    ICON        109, -1, 310, 114, 24, 24
    ICON        109, 1113, 324, 126, 12, 12
    LTEXT       "Clear All Skill Preferences", -1, 342, 116, 195, 10
    LTEXT       "500,000 tech points", -1, 342, 128, 170, 9
    PUSHBUTTON  "Buy", 1013, 542, 117, 55, 18

    ICON        107, -1, 310, 141, 24, 24
    ICON        109, 1114, 324, 153, 12, 12
    LTEXT       "Check Highest Skill (Includes Parenting)", -1, 342, 143, 195, 10
    LTEXT       "1,000,000 tech points", -1, 342, 155, 170, 9
    PUSHBUTTON  "Buy", 1014, 542, 144, 55, 18

    ICON        106, -1, 310, 168, 24, 24
    ICON        109, 1115, 324, 180, 12, 12
    LTEXT       "Check Highest Skill (No Parenting)", -1, 342, 170, 195, 10
    LTEXT       "1,000,000 tech points", -1, 342, 182, 170, 9
    PUSHBUTTON  "Buy", 1015, 542, 171, 55, 18

    ICON        106, -1, 310, 195, 24, 24
    ICON        109, 1116, 324, 207, 12, 12
    LTEXT       "Change Appearance for All", -1, 342, 197, 195, 10
    LTEXT       "450,000 tech points", -1, 342, 209, 170, 9
    PUSHBUTTON  "Buy", 1016, 542, 198, 55, 18

    CTEXT       "Press ESC to exit this menu.", -1, 10, 254, 592, 9
