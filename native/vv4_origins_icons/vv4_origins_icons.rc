/* Change Appearance with the head look (native/shared/head_look.h): 203 and, below the three pickers, a
   "Head look" row -- Auto, Young or Old.  Used when "VVFP Head Look.dll" is in the game; otherwise 203. */
208 DIALOGEX 0, 0, 366, 274
STYLE DS_MODALFRAME | DS_SETFONT | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_THICKFRAME | WS_MINIMIZEBOX | WS_MAXIMIZEBOX
CAPTION "Change Appearance"
FONT 9, "Segoe UI"
BEGIN
    LTEXT       "Body", -1, 30, 8, 70, 9, SS_CENTER
