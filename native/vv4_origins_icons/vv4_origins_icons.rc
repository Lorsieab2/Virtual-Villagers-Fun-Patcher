/* Change Appearance for All (Tech-screen 450,000-point upgrade). WIDE 620x340
   layout (VV2 cross-game parity) so it clears the fullscreen-centering height
   cap no matter how many village-wide radios are added: Male + Female panels on
   the LEFT, four village-wide groups on the RIGHT column (x=382) + a full-width
   Mask-Distribution row along the bottom.
   Four INDEPENDENT exclusive radio sets, each begun by a WS_GROUP radio:
     - Village-wide Heads  3220..3226 (Off / Random-by-gender / 5 hair buckets)
     - Village-wide Bodies 3240..3241 (Off / Random-by-gender)
     - Mask 3200..3210: ONE run (Off + 4 distributions in the bottom box; the 6
       single colours in the right box) -- kept as a single tribe_mode set, so
       exactly one mask strategy applies.
   Owner-draw previews reuse the per-villager picker's draw helpers (mask front
   frame col 5). Picking a non-Off village-wide option greys the matching per-sex
   cyclers (enforced in code: fa_sync_enable). */
214 DIALOGEX 0, 0, 620, 349
STYLE DS_MODALFRAME | DS_SETFONT | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_THICKFRAME | WS_MINIMIZEBOX | WS_MAXIMIZEBOX
CAPTION "Change Appearance for All"
FONT 9, "Segoe UI"
BEGIN
    /* Male panel (left). Preview box 50x74, columns Body 28 / Head 150 / Mask 272. */
    GROUPBOX    "Male Villagers", -1, 6, 2, 368, 120
    LTEXT       "Body", -1, 28, 14, 50, 9, SS_CENTER
    PUSHBUTTON  "<", 3011, 14, 48, 12, 20
    CONTROL     "", 3013, "STATIC", SS_OWNERDRAW | WS_CHILD | WS_VISIBLE, 28, 24, 50, 74
    PUSHBUTTON  ">", 3012, 80, 48, 12, 20
    LTEXT       "Head", -1, 150, 14, 50, 9, SS_CENTER
    PUSHBUTTON  "<", 3001, 136, 48, 12, 20
    CONTROL     "", 3003, "STATIC", SS_OWNERDRAW | WS_CHILD | WS_VISIBLE, 150, 24, 50, 74
    PUSHBUTTON  ">", 3002, 202, 48, 12, 20
    LTEXT       "Mask", -1, 272, 14, 50, 9, SS_CENTER
    PUSHBUTTON  "<", 3021, 258, 48, 12, 20
    CONTROL     "", 3023, "STATIC", SS_OWNERDRAW | WS_CHILD | WS_VISIBLE, 272, 24, 50, 74
    PUSHBUTTON  ">", 3022, 324, 48, 12, 20

    /* Female panel (left). */
    GROUPBOX    "Female Villagers", -1, 6, 126, 368, 120
    LTEXT       "Body", -1, 28, 138, 50, 9, SS_CENTER
    PUSHBUTTON  "<", 3111, 14, 172, 12, 20
    CONTROL     "", 3113, "STATIC", SS_OWNERDRAW | WS_CHILD | WS_VISIBLE, 28, 148, 50, 74
    PUSHBUTTON  ">", 3112, 80, 172, 12, 20
    LTEXT       "Head", -1, 150, 138, 50, 9, SS_CENTER
    PUSHBUTTON  "<", 3101, 136, 172, 12, 20
    CONTROL     "", 3103, "STATIC", SS_OWNERDRAW | WS_CHILD | WS_VISIBLE, 150, 148, 50, 74
    PUSHBUTTON  ">", 3102, 202, 172, 12, 20
    LTEXT       "Mask", -1, 272, 138, 50, 9, SS_CENTER
    PUSHBUTTON  "<", 3121, 258, 172, 12, 20
    CONTROL     "", 3123, "STATIC", SS_OWNERDRAW | WS_CHILD | WS_VISIBLE, 272, 148, 50, 74
    PUSHBUTTON  ">", 3122, 324, 172, 12, 20

    /* Village-wide Heads (right column) -- exclusive set 3220..3226. */
    GROUPBOX    "Village-wide Heads", -1, 382, 2, 232, 120
    AUTORADIOBUTTON "Off (use Head selectors above)", 3220, 390, 16, 216, 10, WS_GROUP | WS_TABSTOP
    AUTORADIOBUTTON "Random (by gender)", 3221, 390, 28, 216, 10
    AUTORADIOBUTTON "All Black Hair", 3222, 390, 40, 216, 10
    AUTORADIOBUTTON "All Brown Hair", 3223, 390, 52, 216, 10
    AUTORADIOBUTTON "All Red / Ginger Hair", 3224, 390, 64, 216, 10
    AUTORADIOBUTTON "All Blonde Hair", 3225, 390, 76, 216, 10
    AUTORADIOBUTTON "All Other Hair / Styles", 3226, 390, 88, 216, 10

    /* Village-wide Bodies (right column) -- exclusive set 3240..3241. */
    GROUPBOX    "Village-wide Bodies", -1, 382, 126, 232, 40
    AUTORADIOBUTTON "Off (use Body selectors above)", 3240, 390, 140, 216, 10, WS_GROUP | WS_TABSTOP
    AUTORADIOBUTTON "Random (by gender)", 3241, 390, 152, 216, 10

    /* Mask groupbox frames (right = single colours; bottom = distributions). The
       mask radios below are ONE exclusive run 3200..3210 regardless of box. */
    GROUPBOX    "Village-wide Single Mask Color", -1, 382, 168, 232, 78
    GROUPBOX    "Mask Distribution (all villagers)", -1, 6, 250, 608, 57

    AUTORADIOBUTTON "Off (use Mask selectors above)", 3200, 14, 264, 288, 10, WS_GROUP | WS_TABSTOP
    AUTORADIOBUTTON "VV5-style (1 Chief, 4 Purple, up to 7 Red, up to 10 Orange, rest Blue)", 3201, 14, 277, 288, 10
    AUTORADIOBUTTON "Random (All 5 + No Mask)", 3202, 14, 290, 288, 10
    AUTORADIOBUTTON "Random (All 5)", 3203, 318, 264, 288, 10
    AUTORADIOBUTTON "Equal Colors (All 5 colors; balanced M/F)", 3204, 318, 277, 288, 10
    AUTORADIOBUTTON "None (remove all masks)", 3205, 390, 182, 110, 10
    AUTORADIOBUTTON "Blue", 3206, 390, 196, 110, 10
    AUTORADIOBUTTON "Orange", 3207, 390, 210, 110, 10
    AUTORADIOBUTTON "Red", 3208, 504, 182, 100, 10
    AUTORADIOBUTTON "Purple", 3209, 504, 196, 100, 10
    AUTORADIOBUTTON "Chief", 3210, 504, 210, 100, 10

    LTEXT       "Head look:", 3525, 14, 108, 40, 9
    AUTORADIOBUTTON "Leave as is", 3520, 56, 107, 52, 10, WS_GROUP | WS_TABSTOP
    AUTORADIOBUTTON "Auto (old from 55)", 3521, 112, 107, 78, 10
    AUTORADIOBUTTON "Young", 3522, 194, 107, 38, 10
    AUTORADIOBUTTON "Old", 3523, 236, 107, 30, 10
    AUTORADIOBUTTON "Random", 3524, 270, 107, 44, 10
    LTEXT       "Head look:", 3535, 14, 232, 40, 9
    AUTORADIOBUTTON "Leave as is", 3530, 56, 231, 52, 10, WS_GROUP | WS_TABSTOP
    AUTORADIOBUTTON "Auto (old from 55)", 3531, 112, 231, 78, 10
    AUTORADIOBUTTON "Young", 3532, 194, 231, 38, 10
    AUTORADIOBUTTON "Old", 3533, 236, 231, 30, 10
    AUTORADIOBUTTON "Random", 3534, 270, 231, 44, 10

    CTEXT "OK deducts 450,000 tech points. Cancel changes nothing.", -1, 6, 315, 608, 9, WS_GROUP
    PUSHBUTTON  "Undo changes", 3500, 8, 327, 64, 16
    PUSHBUTTON  "Reset to original", 3501, 76, 327, 78, 16
    DEFPUSHBUTTON "OK", 1, 250, 327, 50, 16
    PUSHBUTTON    "Cancel", 2, 316, 327, 50, 16
END
