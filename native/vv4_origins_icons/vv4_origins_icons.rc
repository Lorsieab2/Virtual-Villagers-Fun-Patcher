203 DIALOGEX 0, 0, 366, 248
STYLE DS_MODALFRAME | DS_SETFONT | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_THICKFRAME | WS_MINIMIZEBOX | WS_MAXIMIZEBOX
CAPTION "Change Appearance"
FONT 9, "Segoe UI"
BEGIN
    /* Body / Head / Mask in one row; preview box 70x118 (VV2 5-game parity). */
    LTEXT       "Body", -1, 30, 8, 70, 9, SS_CENTER
    PUSHBUTTON  "<", 2011, 10, 72, 16, 16
    CONTROL     "", 2013, "STATIC", SS_OWNERDRAW | WS_CHILD | WS_VISIBLE, 30, 20, 70, 118
