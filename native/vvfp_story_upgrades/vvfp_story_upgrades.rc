    LTEXT       "", 2053, 206, 178, 44, 10
    EDITTEXT    2043, 250, 176, 28, 13, ES_NUMBER | WS_TABSTOP
    LTEXT       "", 2054, 284, 178, 44, 10
    EDITTEXT    2044, 328, 176, 28, 13, ES_NUMBER | WS_TABSTOP
    LTEXT       "", 2055, 362, 178, 44, 10
    EDITTEXT    2045, 406, 176, 28, 13, ES_NUMBER | WS_TABSTOP
    LTEXT       "Custom title:", -1, 206, 196, 70, 10
    EDITTEXT    2060, 280, 194, 172, 13, ES_AUTOHSCROLL | WS_TABSTOP
    AUTOCHECKBOX "Remove the custom title", 2061, 280, 210, 172, 10, WS_TABSTOP
    LTEXT       "Mask:", -1, 206, 226, 70, 10
    COMBOBOX    2070, 280, 224, 172, 120, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT       "Faction / status:", -1, 206, 242, 70, 10
    COMBOBOX    2071, 280, 240, 172, 120, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT       "Behaviour:", -1, 206, 258, 70, 10
    COMBOBOX    2074, 280, 256, 172, 120, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON  "Parents...", 2080, 280, 274, 80, 14, WS_TABSTOP
    LTEXT       "", 2081, 364, 276, 88, 12
    PUSHBUTTON  "Baby's father...", 2082, 280, 290, 80, 14, WS_TABSTOP
    LTEXT       "", 2083, 364, 292, 88, 12

    LTEXT       "", 2090, 8, 306, 444, 20
    DEFPUSHBUTTON "Add to event", 1, 316, 326, 64, 15
    PUSHBUTTON  "Cancel", 2, 388, 326, 64, 15
END

