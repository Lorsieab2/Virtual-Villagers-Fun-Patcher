/* The Story / Cheat Upgrades dialogs: plain Windows dialogs (the owner's
   explicit choice -- not game art).

   301 Pick Island Event: a list of the game's island events by their official
       titles, the selected event's one-line description under it, OK and
       Cancel.  The list is filled at run time from story_tables.h.
   302 Custom Island Event: the event's title and description, the village
       changes, the new villagers and the villager changes.
   303 Villager changes: the villagers (extended selection) and the five group
       toggles, and the changes for them.
   304 New villagers: one kind of new villager and how many.
   305 Parents: the parentage data of the chosen villagers.
   306 Food sources: set a food source or store to an amount.
   307 Puzzles: mark puzzles solved or unsolved.
   308 Revive: skeletons brought back to life.
   309 The unborn baby's father.
   310 Choices: a two-choice event's button labels and each button's outcomes
       (each edited in 302's outcome mode) with their chances.
   Controls a game cannot support are disabled at run time and say why. */
#define DS_MODALFRAME 0x0080L
#define DS_SETFONT 0x0040L
#define DS_CENTER 0x0800L
#define WS_POPUP 0x80000000L
#define WS_CAPTION 0x00C00000L
#define WS_SYSMENU 0x00080000L
#define WS_VSCROLL 0x00200000L
#define WS_TABSTOP 0x00010000L
#define WS_BORDER 0x00800000L
#define WS_GROUP 0x00020000L
#define LBS_NOTIFY 0x0001L
#define LBS_NOINTEGRALHEIGHT 0x0100L
#define LBS_EXTENDEDSEL 0x0800L
#define LBS_MULTIPLESEL 0x0008L
#define SS_LEFT 0x0000L
#define ES_AUTOHSCROLL 0x0080L
#define ES_AUTOVSCROLL 0x0040L
#define ES_MULTILINE 0x0004L
#define ES_WANTRETURN 0x1000L
#define ES_NUMBER 0x2000L
#define CBS_DROPDOWNLIST 0x0003L
#define BS_AUTOCHECKBOX 0x0003L

301 DIALOGEX 0, 0, 480, 300
STYLE DS_MODALFRAME | DS_SETFONT | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Pick Island Event"
FONT 9, "Segoe UI"
BEGIN
    LTEXT       "Choose the island event that will happen next:", 3010, 8, 6, 210, 10
    LISTBOX     3001, 8, 18, 210, 254, LBS_NOTIFY | LBS_NOINTEGRALHEIGHT | WS_VSCROLL | WS_BORDER | WS_TABSTOP
    LTEXT       "", 3002, 226, 18, 246, 44, SS_LEFT
    LTEXT       "How it turns out (Random is the original game's own choice):", -1, 226, 64, 246, 10
    LISTBOX     3003, 226, 76, 246, 78, LBS_NOTIFY | LBS_NOINTEGRALHEIGHT | WS_VSCROLL | WS_BORDER | WS_TABSTOP
    LTEXT       "", 3009, 226, 157, 246, 18, SS_LEFT
    COMBOBOX    3004, 226, 177, 246, 160, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    EDITTEXT    3005, 226, 194, 80, 13, ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT       "", 3006, 312, 196, 160, 10
    LISTBOX     3007, 226, 194, 246, 78, LBS_NOTIFY | LBS_EXTENDEDSEL | LBS_NOINTEGRALHEIGHT | WS_VSCROLL | WS_BORDER | WS_TABSTOP
    DEFPUSHBUTTON "OK", 1, 336, 278, 64, 15
    PUSHBUTTON  "Cancel", 2, 408, 278, 64, 15
END

302 DIALOGEX 0, 0, 420, 434
STYLE DS_MODALFRAME | DS_SETFONT | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Custom Island Event"
FONT 9, "Segoe UI"
BEGIN
    LTEXT       "Event title:", -1, 8, 8, 60, 10
    EDITTEXT    1101, 70, 6, 256, 13, ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT       "", 1124, 330, 8, 82, 10
    LTEXT       "Description:", 1139, 8, 24, 60, 10
    EDITTEXT    1102, 70, 22, 342, 48, ES_MULTILINE | ES_AUTOVSCROLL | ES_WANTRETURN | WS_VSCROLL | WS_TABSTOP
    LTEXT       "", 1109, 70, 72, 342, 9

    GROUPBOX    "The village", -1, 8, 84, 404, 82
    LTEXT       "Food:", -1, 16, 98, 50, 10
    COMBOBOX    1103, 70, 96, 110, 80, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    EDITTEXT    1104, 186, 96, 60, 13, ES_NUMBER | WS_TABSTOP
    LTEXT       "Tech points:", -1, 16, 114, 50, 10
    COMBOBOX    1105, 70, 112, 110, 80, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    EDITTEXT    1106, 186, 112, 60, 13, ES_NUMBER | WS_TABSTOP
    AUTOCHECKBOX "Refill the food sources", 1107, 16, 130, 230, 10, WS_TABSTOP
    LTEXT       "", 1110, 16, 142, 230, 20
    LTEXT       "Village and puzzle changes (click to tick):", -1, 254, 96, 152, 10
    LISTBOX     1108, 254, 108, 152, 52, LBS_MULTIPLESEL | LBS_NOINTEGRALHEIGHT | WS_VSCROLL | WS_BORDER | WS_TABSTOP

    GROUPBOX    "New villagers", -1, 8, 170, 404, 66
    LISTBOX     1111, 16, 182, 300, 50, LBS_NOINTEGRALHEIGHT | WS_VSCROLL | WS_BORDER | WS_TABSTOP
    PUSHBUTTON  "Add...", 1112, 324, 182, 80, 14, WS_TABSTOP
    PUSHBUTTON  "Remove", 1113, 324, 200, 80, 14, WS_TABSTOP

    GROUPBOX    "Villager changes", -1, 8, 240, 404, 84
    LISTBOX     1121, 16, 252, 300, 68, LBS_NOINTEGRALHEIGHT | WS_VSCROLL | WS_BORDER | WS_TABSTOP
    PUSHBUTTON  "Add...", 1122, 324, 252, 80, 14, WS_TABSTOP
    PUSHBUTTON  "Remove", 1123, 324, 270, 80, 14, WS_TABSTOP

    GROUPBOX    "Food sources, puzzles and revivals", -1, 8, 328, 404, 62
    LISTBOX     1131, 16, 340, 300, 46, LBS_NOINTEGRALHEIGHT | WS_VSCROLL | WS_BORDER | WS_TABSTOP
    PUSHBUTTON  "Food sources...", 1132, 324, 338, 80, 11, WS_TABSTOP
    PUSHBUTTON  "Puzzles...", 1133, 324, 350, 80, 11, WS_TABSTOP
    PUSHBUTTON  "Revive...", 1134, 324, 362, 80, 11, WS_TABSTOP
    PUSHBUTTON  "Remove", 1135, 324, 374, 80, 11, WS_TABSTOP

    AUTOCHECKBOX "Ask a question with two choices", 1137, 8, 396, 150, 10, WS_TABSTOP
    PUSHBUTTON  "Choices...", 1138, 162, 394, 80, 14, WS_TABSTOP

    PUSHBUTTON  "Not in this game...", 1114, 8, 412, 80, 15, WS_TABSTOP
    LTEXT       "It happens shortly, as a bought Island Event does.", 1136, 94, 412, 178, 18
    DEFPUSHBUTTON "Queue event", 1, 276, 412, 64, 15
    PUSHBUTTON  "Cancel", 2, 348, 412, 64, 15
END

