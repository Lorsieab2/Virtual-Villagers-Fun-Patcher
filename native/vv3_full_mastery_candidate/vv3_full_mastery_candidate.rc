    PUSHBUTTON  "Red / Ginger", 3512, 184, 194, 54, 13
    PUSHBUTTON  "Blonde", 3513, 242, 194, 40, 13
    PUSHBUTTON  "Other", 3514, 286, 194, 40, 13

