213 DIALOGEX 0, 0, 364, 248
STYLE DS_MODALFRAME | DS_SETFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_THICKFRAME | WS_MINIMIZEBOX | WS_MAXIMIZEBOX
CAPTION "Change Appearance"
FONT 9, "Segoe UI"
BEGIN
    CTEXT       "Body", -1, 30, 8, 70, 9
    CONTROL     "", 3101, "STATIC", SS_OWNERDRAW | WS_CHILD | WS_VISIBLE, 30, 20, 70, 118
    PUSHBUTTON  "<", 3103, 10, 72, 16, 16
    PUSHBUTTON  ">", 3104, 104, 72, 16, 16

    CTEXT       "Head", -1, 150, 8, 70, 9
    CONTROL     "", 3102, "STATIC", SS_OWNERDRAW | WS_CHILD | WS_VISIBLE, 150, 20, 70, 118
