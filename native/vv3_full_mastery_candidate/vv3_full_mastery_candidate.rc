    LTEXT       "Full Heal / Cure All", -1, 40, 143, 195, 10
    LTEXT       "30,000 tech points", -1, 40, 155, 150, 9
    PUSHBUTTON  "Buy", 1005, 240, 144, 55, 18

    ICON        108, -1, 8, 168,  24, 24
    ICON        109, 1106, 22, 180, 12, 12
    LTEXT       "Grant Running to All Villagers", -1, 40, 170, 195, 10
    LTEXT       "1,000,000 tech points", -1, 40, 182, 170, 9
    PUSHBUTTON  "Buy", 1006, 240, 171, 55, 18

    /* Right column (rows 7..12, then 14..16, then 13): the two Equal Division
       rows, Clear All Skill Preferences and the two Check Highest Skill rows,
       with Change Appearance for All last.  Its control id stays 1013 (the
       executable's payload routes rows by that number); the blocks are
       listed in on-screen order so Tab follows what the player sees. */
    ICON        107, -1, 310,   6,  24, 24
    ICON        109, 1107, 324, 18, 12, 12
    LTEXT       "Grant Full Mastery to All Villagers", -1, 342, 8, 195, 10
    LTEXT       "1,000,000 tech points", -1, 342, 20, 170, 9
    PUSHBUTTON  "Buy", 1007, 542, 9, 55, 18

    ICON        106, -1, 310,  33,  24, 24
    ICON        109, 1108, 324, 45, 12, 12
    LTEXT       "All Villagers are Exactly 18", -1, 342, 35, 195, 10
    LTEXT       "1,000,000 tech points", -1, 342, 47, 170, 9
    PUSHBUTTON  "Buy", 1008, 542, 36, 55, 18

    ICON        104, -1, 310,  60,  24, 24
    ICON        109, 1109, 324, 72, 12, 12
    LTEXT       "Complete All Collections", -1, 342, 62, 195, 10
    LTEXT       "1,000,000 tech points", -1, 342, 74, 170, 9
    PUSHBUTTON  "Buy", 1009, 542, 63, 55, 18

    ICON        105, -1, 310,  87,  24, 24
    ICON        109, 1110, 324, 99, 12, 12
    LTEXT       "Reset All Collections", -1, 342, 89, 195, 10
    LTEXT       "1,000,000 tech points", -1, 342, 101, 170, 9
    PUSHBUTTON  "Buy", 1010, 542, 90, 55, 18

    ICON        108, -1, 310, 114,  24, 24
    ICON        109, 1111, 324, 126, 12, 12
    LTEXT       "Equal Division of Labor (Includes Parenting)", -1, 342, 116, 195, 10
    LTEXT       "1,000,000 tech points", -1, 342, 128, 170, 9
    PUSHBUTTON  "Buy", 1011, 542, 117, 55, 18

    ICON        107, -1, 310, 141,  24, 24
    ICON        109, 1112, 324, 153, 12, 12
    LTEXT       "Equal Division of Labor (No Parenting)", -1, 342, 143, 195, 10
    LTEXT       "1,000,000 tech points", -1, 342, 155, 170, 9
    PUSHBUTTON  "Buy", 1012, 542, 144, 55, 18

    ICON        108, -1, 310, 168,  24, 24
    ICON        109, 1114, 324, 180, 12, 12
    LTEXT       "Clear All Skill Preferences", -1, 342, 170, 195, 10
    LTEXT       "500,000 tech points", -1, 342, 182, 170, 9
    PUSHBUTTON  "Buy", 1014, 542, 171, 55, 18

    ICON        107, -1, 310, 195,  24, 24
    ICON        109, 1115, 324, 207, 12, 12
    LTEXT       "Check Highest Skill (Includes Parenting)", -1, 342, 197, 195, 10
    LTEXT       "1,000,000 tech points", -1, 342, 209, 170, 9
    PUSHBUTTON  "Buy", 1015, 542, 198, 55, 18

    ICON        107, -1, 310, 222,  24, 24
    ICON        109, 1116, 324, 234, 12, 12
    LTEXT       "Check Highest Skill (No Parenting)", -1, 342, 224, 195, 10
    LTEXT       "1,000,000 tech points", -1, 342, 236, 170, 9
    PUSHBUTTON  "Buy", 1016, 542, 225, 55, 18

    ICON        106, -1, 310, 249,  24, 24
    ICON        109, 1113, 324, 261, 12, 12
    LTEXT       "Change Appearance for All", -1, 342, 251, 195, 10
    LTEXT       "450,000 tech points", -1, 342, 263, 170, 9
    PUSHBUTTON  "Buy", 1013, 542, 252, 55, 18

    CTEXT       "Press ESC to exit this menu.", -1, 10, 281, 592, 9
    DEFPUSHBUTTON "Cancel", 2, 271, 293, 70, 14
END

