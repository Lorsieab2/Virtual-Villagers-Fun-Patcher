214 DIALOGEX 0, 0, 620, 346
STYLE DS_MODALFRAME | DS_SETFONT | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_THICKFRAME | WS_MINIMIZEBOX | WS_MAXIMIZEBOX
CAPTION "Change Appearance for All"
FONT 9, "Segoe UI"
BEGIN
    GROUPBOX    "Male Villagers", -1, 6, 2, 368, 120
    CTEXT       "Body", -1, 28, 12, 50, 9
    PUSHBUTTON  "<", 3202, 14, 44, 12, 20
    CONTROL     "", 3201, "STATIC", SS_OWNERDRAW | WS_CHILD | WS_VISIBLE, 28, 20, 50, 74
    PUSHBUTTON  ">", 3203, 80, 44, 12, 20
    CTEXT       "Head", -1, 150, 12, 50, 9
    PUSHBUTTON  "<", 3205, 136, 44, 12, 20
    CONTROL     "", 3204, "STATIC", SS_OWNERDRAW | WS_CHILD | WS_VISIBLE, 150, 20, 50, 74
    PUSHBUTTON  ">", 3206, 202, 44, 12, 20
    CTEXT       "Mask", -1, 272, 12, 50, 9
    CTEXT       "", 3210, 258, 95, 78, 9
    PUSHBUTTON  "<", 3208, 258, 44, 12, 20
    CONTROL     "", 3207, "STATIC", SS_OWNERDRAW | WS_CHILD | WS_VISIBLE, 272, 20, 50, 74
    PUSHBUTTON  ">", 3209, 324, 44, 12, 20

    GROUPBOX    "Female Villagers", -1, 6, 126, 368, 120
    CTEXT       "Body", -1, 28, 136, 50, 9
    PUSHBUTTON  "<", 3222, 14, 168, 12, 20
    CONTROL     "", 3221, "STATIC", SS_OWNERDRAW | WS_CHILD | WS_VISIBLE, 28, 144, 50, 74
    PUSHBUTTON  ">", 3223, 80, 168, 12, 20
    CTEXT       "Head", -1, 150, 136, 50, 9
    PUSHBUTTON  "<", 3225, 136, 168, 12, 20
    CONTROL     "", 3224, "STATIC", SS_OWNERDRAW | WS_CHILD | WS_VISIBLE, 150, 144, 50, 74
    PUSHBUTTON  ">", 3226, 202, 168, 12, 20
    CTEXT       "Mask", -1, 272, 136, 50, 9
    CTEXT       "", 3230, 258, 219, 78, 9
    PUSHBUTTON  "<", 3228, 258, 168, 12, 20
    CONTROL     "", 3227, "STATIC", SS_OWNERDRAW | WS_CHILD | WS_VISIBLE, 272, 144, 50, 74
    PUSHBUTTON  ">", 3229, 324, 168, 12, 20

    /* Village-wide Heads (right column) -- exclusive set 3400..3406.  VV1/VV2/
       VV4/VV5 put this set at 3220..3226, which VV3 cannot reuse: 3220..3229 is
       already its FEMALE panel.  Hence the 3400 block. */
    GROUPBOX    "Village-wide Heads", -1, 382, 2, 232, 120
    AUTORADIOBUTTON "Off (use Head selectors above)", 3400, 390, 16, 216, 10, WS_GROUP
    AUTORADIOBUTTON "Random (by gender)", 3401, 390, 28, 216, 10
    AUTORADIOBUTTON "All Black Hair", 3402, 390, 40, 216, 10
    AUTORADIOBUTTON "All Brown Hair", 3403, 390, 52, 216, 10
    AUTORADIOBUTTON "All Red / Ginger Hair", 3404, 390, 64, 216, 10
    AUTORADIOBUTTON "All Blonde Hair", 3405, 390, 76, 216, 10
    AUTORADIOBUTTON "All Other Hair / Styles", 3406, 390, 88, 216, 10

    /* Village-wide Bodies (right column) -- exclusive set 3410..3411. */
    GROUPBOX    "Village-wide Bodies", -1, 382, 126, 232, 40
    AUTORADIOBUTTON "Off (use Body selectors above)", 3410, 390, 140, 216, 10, WS_GROUP
    AUTORADIOBUTTON "Random (by gender)", 3411, 390, 152, 216, 10

    /* Mask groupbox frames (right = single colours; bottom = distributions).
       The mask radios below are ONE exclusive run 3301..3310 regardless of which
       box they sit in, so a single colour and a distribution cannot both be
       chosen.  The Heads/Bodies sets above each open their own run with
       WS_GROUP, which is what keeps them independent of this one. */
    GROUPBOX    "Village-wide Single Mask Color", -1, 382, 168, 232, 78
    GROUPBOX    "Mask Distribution (all villagers)", -1, 6, 250, 608, 54

    AUTORADIOBUTTON "Off (use Mask selectors above)", 3301, 14, 261, 288, 10, WS_GROUP
    AUTORADIOBUTTON "VV5-style (1 Chief, 4 Purple, up to 7 Red, up to 10 Orange, rest Blue)", 3302, 14, 274, 288, 10
    AUTORADIOBUTTON "Random (All 5 + No Mask)", 3303, 14, 287, 288, 10
    AUTORADIOBUTTON "Random (All 5)", 3304, 318, 261, 288, 10
    AUTORADIOBUTTON "Equal Colors (All 5 colors; balanced M/F)", 3305, 318, 274, 288, 10
    AUTORADIOBUTTON "None (remove all masks)", 3306, 390, 182, 110, 10
    AUTORADIOBUTTON "Blue", 3307, 390, 196, 110, 10
    AUTORADIOBUTTON "Orange", 3308, 390, 210, 110, 10
    AUTORADIOBUTTON "Red", 3309, 504, 182, 100, 10
    AUTORADIOBUTTON "Purple", 3310, 504, 196, 100, 10
    AUTORADIOBUTTON "Chief", 3311, 504, 210, 100, 10

    LTEXT       "Head look:", 3525, 14, 108, 40, 9
    AUTORADIOBUTTON "Leave as is", 3520, 56, 107, 52, 10, WS_GROUP
    AUTORADIOBUTTON "Auto (old from 55)", 3521, 112, 107, 78, 10
    AUTORADIOBUTTON "Young", 3522, 194, 107, 38, 10
    AUTORADIOBUTTON "Old", 3523, 236, 107, 30, 10
    AUTORADIOBUTTON "Random", 3524, 270, 107, 44, 10
    LTEXT       "Head look:", 3535, 14, 232, 40, 9
    AUTORADIOBUTTON "Leave as is", 3530, 56, 231, 52, 10, WS_GROUP
    AUTORADIOBUTTON "Auto (old from 55)", 3531, 112, 231, 78, 10
    AUTORADIOBUTTON "Young", 3532, 194, 231, 38, 10
    AUTORADIOBUTTON "Old", 3533, 236, 231, 30, 10
    AUTORADIOBUTTON "Random", 3534, 270, 231, 44, 10

    CTEXT       "OK deducts 450,000 tech points. Cancel changes nothing.", -1, 6, 312, 608, 9, WS_GROUP
    PUSHBUTTON  "Undo changes", 3500, 8, 324, 64, 16
    PUSHBUTTON  "Reset to original", 3501, 76, 324, 78, 16
    DEFPUSHBUTTON "OK", 1, 250, 324, 50, 16
    PUSHBUTTON  "Cancel", 2, 316, 324, 50, 16
END
