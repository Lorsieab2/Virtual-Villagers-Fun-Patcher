/* Change Appearance with the head look (native/shared/head_look.h): 213 and, below the three pickers, a
   "Head look" row -- Auto, Young or Old.  Used when "VVFP Head Look.dll" is in the game; otherwise 213. */
208 DIALOGEX 0, 0, 364, 274
STYLE DS_MODALFRAME | DS_SETFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_THICKFRAME | WS_MINIMIZEBOX | WS_MAXIMIZEBOX
CAPTION "Change Appearance"
FONT 9, "Segoe UI"
BEGIN
    CTEXT       "Body", -1, 30, 8, 70, 9
    CONTROL     "", 3101, "STATIC", SS_OWNERDRAW | WS_CHILD | WS_VISIBLE, 30, 20, 70, 118
    PUSHBUTTON  "<", 3103, 10, 72, 16, 16
    PUSHBUTTON  ">", 3104, 104, 72, 16, 16

    CTEXT       "Head", -1, 150, 8, 70, 9
    CONTROL     "", 3102, "STATIC", SS_OWNERDRAW | WS_CHILD | WS_VISIBLE, 150, 20, 70, 118
    PUSHBUTTON  "<", 3105, 130, 72, 16, 16
    PUSHBUTTON  ">", 3106, 224, 72, 16, 16

    CTEXT       "Mask", -1, 270, 8, 70, 9
    CONTROL     "", 3110, "STATIC", SS_OWNERDRAW | WS_CHILD | WS_VISIBLE, 270, 20, 70, 118
    PUSHBUTTON  "<", 3108, 250, 72, 16, 16
    PUSHBUTTON  ">", 3109, 344, 72, 16, 16
    CTEXT       "(None)", 3107, 260, 142, 90, 10

    GROUPBOX        "Head look", -1, 16, 154, 332, 26
    AUTORADIOBUTTON "Auto (old from 55)", 3120, 30, 166, 100, 10, WS_GROUP
    AUTORADIOBUTTON "Young", 3121, 160, 166, 60, 10
    AUTORADIOBUTTON "Old", 3122, 250, 166, 34, 10

    PUSHBUTTON  "Random", 3505, 290, 163, 50, 13
    GROUPBOX        "Randomize", -1, 16, 190, 332, 44
    PUSHBUTTON  "Random head", 3502, 24, 201, 66, 13
    PUSHBUTTON  "Random body", 3503, 94, 201, 66, 13
    PUSHBUTTON  "Random mask", 3504, 164, 201, 66, 13
    LTEXT       "Head by hair colour:", -1, 24, 218, 70, 9
    PUSHBUTTON  "Black", 3510, 96, 216, 40, 13
    PUSHBUTTON  "Brown", 3511, 140, 216, 40, 13
    PUSHBUTTON  "Red / Ginger", 3512, 184, 216, 54, 13
    PUSHBUTTON  "Blonde", 3513, 242, 216, 40, 13
    PUSHBUTTON  "Other", 3514, 286, 216, 40, 13

    CTEXT       "OK deducts 5,000 tech points, for the head look too. Cancel changes nothing.", -1, 8, 240, 348, 9
    PUSHBUTTON  "Undo changes", 3500, 16, 254, 64, 16
    PUSHBUTTON  "Reset to original", 3501, 84, 254, 78, 16
