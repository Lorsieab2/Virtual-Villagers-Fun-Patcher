LIBRARY "VVFP Origins Icons"
EXPORTS
    ShowOriginsUpgradeMenu=_ShowOriginsUpgradeMenu@8
    ShowOriginsUpgradeMenuState=_ShowOriginsUpgradeMenuState@8
    ShowOriginsVillageWideResult=_ShowOriginsVillageWideResult@4
    PrepareOriginsVillageWide=_PrepareOriginsVillageWide@4
    PrepareBarrelBabies=_PrepareBarrelBabies@0
    ShowOriginsUpgradeResult=_ShowOriginsUpgradeResult@4
    EqualDivisionOfLabor=_EqualDivisionOfLabor@4
    ShowOriginsFullMasteryResult=_ShowOriginsFullMasteryResult@8
    ShowVV3AppearanceChooser=_ShowVV3AppearanceChooser@20
    ShowVV3TimeWarp=_ShowVV3TimeWarp@4
    VV3GetMaskAtlas=_VV3GetMaskAtlas@0
    VV3_GetMaskForRecord=_VV3_GetMaskForRecord@4
    VV3_SetMaskForRecord=_VV3_SetMaskForRecord@8
    VV3RunningMaskBoundary=_VV3RunningMaskBoundary@4
    VV3DrawMaskOnHead=_VV3DrawMaskOnHead@12
    VV3WorldMaskDrawAt=_VV3WorldMaskDrawAt@8 @102
    ; Pinned to ordinal 101 for tooling and diagnostics; the world wrapper uses the
    ; function pointer published in the patch-owned .vv3md slot.
    ShowVV3AppearanceForAll=_ShowVV3AppearanceForAll@0 @100
    ; Pinned to ordinal 100 so the exe dispatch can resolve it BY ORDINAL
    ; (push 100) instead of the 24-byte name string, which overflowed the tiny
    ; .text string cave (VV2's ordinal-resolution tip).
